# Analytics (optional, defaults to noop / disabled)
# NEXT_PUBLIC_ANALYTICS_PROVIDER=noop|console|vercel|custom   # default: noop
# NEXT_PUBLIC_ANALYTICS_ENABLED=true|false                    # default: true
# NEXT_PUBLIC_ANALYTICS_DEBUG=true|false                      # default: false
# NEXT_PUBLIC_ANALYTICS_PAGE_ALLOWLIST=/work/foo,/work/bar    # only track these page prefixes
# NEXT_PUBLIC_ANALYTICS_PAGE_DENYLIST=/dev,/playground        # exclude these page prefixes

# Non-secret project config (content dir, dev API, rate limits) lives in peblor.config.json.
# Env vars below still take precedence for CI/machine-specific overrides.

# Production runtime (required)
# ACCESS_TOKEN_VERSION (required): stable token version; change to invalidate existing access cookies.
ACCESS_TOKEN_VERSION=
# RATE_LIMIT_SECRET (required): fingerprint secret for rate-limit keys.
RATE_LIMIT_SECRET=
# FORM_RATE_LIMIT_SECRET (required in production): HMAC secret for form rate-limit cookies.
FORM_RATE_LIMIT_SECRET=

# Production/runtime (optional)
# SITE_PASSWORD (optional): shared password for protected pages.
# SITE_PASSWORD=your-secret
# BUNNY_TOKEN_SECRET (optional): used for Bunny CDN integration.
# BUNNY_TOKEN_SECRET=replace-with-secret

# Development only (optional)
# NEXT_PUBLIC_DEV_TOOLS_URL (optional): dev tools side-server base URL.
# NEXT_PUBLIC_DEV_TOOLS_URL=http://localhost:4319
# NEXT_PUBLIC_DEV_HLS_URL (optional): legacy direct HLS endpoint override.
# NEXT_PUBLIC_DEV_HLS_URL=http://localhost:4319/tools/hls/convert

# These can be overridden in peblor.config.json instead:
#   VALIDATE_PAGES_BASE_REF  →  validatePagesBaseRef
#   ENABLE_DEV_API           →  enableDevApi
#   RATE_LIMIT_MEMORY_MAX    →  rateLimitMemoryMax
#   RATE_LIMIT_COOKIE_SAMESITE → rateLimitCookieSameSite

# Form delivery (optional, per handler)
# RESEND_API_KEY (optional): Resend API key for outbound email handlers.
# RESEND_API_KEY=re_xxx
# FORM_CONTACT_FROM (optional): sender for contact email handler.
# FORM_CONTACT_FROM=Site <noreply@yourdomain.com>
# FORM_CONTACT_RECIPIENT (optional): recipient for contact email handler.
# FORM_CONTACT_RECIPIENT=you@yourdomain.com
# Optional per-handler recipients:
# FORM_NEWSLETTER_RECIPIENT=...
# FORM_EVENT_RECIPIENT=...
# FORM_FEEDBACK_RECIPIENT=...
# FORM_JOB_INQUIRY_RECIPIENT=...
# FORM_QUOTE_RECIPIENT=...
# FORM_APPLICATION_RECIPIENT=...
# FORM_RSVP_RECIPIENT=...
# FORM_GATED_RECIPIENT=...
# FORM_WAITLIST_RECIPIENT=...
# FORM_UNSUBSCRIBE_RECIPIENT=...
# Optional webhooks (POST JSON payload): NEWSLETTER_WEBHOOK_URL, WAITLIST_WEBHOOK_URL, UNSUBSCRIBE_WEBHOOK_URL
# Optional gated redirect path after signup.
# GATED_ASSET_REDIRECT=/downloads/thank-you
# Optional magic-link token signing secret.
# MAGIC_LINK_SECRET=optional-secret-for-token-signing
