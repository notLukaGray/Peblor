          "definitions": {
            "panel-one": {
              "preset": "card-preview-panel",
              "visibleWhen": {
                "logic": "and",
                "conditions": [
                  {
                    "variable": "selectedCard",
                    "operator": "notEquals",
                    "value": "card-two"
                  },
                  {
                    "variable": "selectedCard",
                    "operator": "notEquals",
                    "value": "card-three"
                  },
                  {
                    "variable": "selectedCard",
