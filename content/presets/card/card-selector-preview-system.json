{
  "type": "elementGroup",
  "display": "flex",
  "flow": {
    "base": "column",
    "md": "row"
  },
  "align": "stretch",
  "gap": {
    "base": "1rem",
    "md": "2.5rem"
  },
  "width": "100%",
  "section": {
    "elementOrder": ["list-col", "preview-col"],
    "definitions": {
      "list-col": {
        "type": "elementGroup",
        "width": {
          "base": "100%",
          "md": "min(22rem, 40%)"
        },
        "flex": "0 0 auto",
        "display": "flex",
        "flow": "column",
        "section": {
          "elementOrder": ["card-scroll"],
          "definitions": {
            "card-scroll": {
              "type": "elementInfiniteScroll",
              "width": "100%",
              "height": {
                "base": "clamp(12rem, 34dvh, 18rem)",
                "md": "clamp(14rem, 40dvh, 24rem)"
              },
              "scrollDirection": "vertical",
              "loop": true,
              "initialIndex": 0,
              "selectedValueVariable": "selectedCard",
              "selectedValues": {
                "card-item-one": "card-one",
                "card-item-two": "card-two",
                "card-item-three": "card-three",
                "card-item-four": "card-four"
              },
              "centerOnClick": true,
              "wheelLockMs": 220,
              "snapDurationMs": 480,
              "activeScale": 1,
              "inactiveScale": 0.93,
              "activeOpacity": 1,
              "inactiveOpacity": 0.42,
              "activeItemStyle": {
                "--card-list-title-color": "var(--pb-on-secondary)",
                "--card-list-arrow-color": "var(--pb-on-secondary)"
              },
              "inactiveItemStyle": {
                "--card-list-title-color": "color-mix(in oklab, var(--pb-on-secondary) 50%, transparent)",
                "--card-list-arrow-color": "color-mix(in oklab, var(--pb-on-secondary) 24%, transparent)"
              },
              "display": "flex",
              "flow": "column",
              "gap": "0",
              "scroll": "auto",
              "section": {
                "elementOrder": [
                  "card-item-one",
                  "card-item-two",
                  "card-item-three",
                  "card-item-four"
                ],
                "definitions": {
                  "card-item-one": {
                    "type": "elementGroup",
                    "width": "100%",
                    "height": "hug",
                    "display": "flex",
                    "flow": "row",
                    "align": "center",
                    "distribute": "between",
                    "gap": "0.75rem",
                    "padding": "1rem 0",
                    "wrapperStyle": {
                      "borderBottom": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
                    },
                    "section": {
                      "elementOrder": ["item-title", "item-arrow"],
                      "definitions": {
                        "item-title": {
                          "type": "elementBody",
                          "level": 3,
                          "width": "100%",
                          "textAlign": "left",
                          "text": "Feature Cards",
                          "color": "var(--card-list-title-color, var(--pb-on-secondary))"
                        },
                        "item-arrow": {
                          "type": "elementBody",
                          "level": 3,
                          "width": "hug",
                          "text": "→",
                          "color": "var(--card-list-arrow-color, color-mix(in oklab, var(--pb-on-secondary) 44%, transparent))"
                        }
                      }
                    }
                  },
                  "card-item-two": {
                    "type": "elementGroup",
                    "width": "100%",
                    "height": "hug",
