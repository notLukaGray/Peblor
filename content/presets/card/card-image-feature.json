{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "gap": "0",
  "width": "100%",
  "padding": "0.75rem",
  "borderRadius": "24px",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, transparent)",
  "motion": {
    "onHover": {
      "y": -4
    },
    "transition": {
      "duration": 0.18
    }
  },
  "section": {
    "elementOrder": ["image", "copy"],
    "definitions": {
      "image": {
        "type": "elementImage",
        "src": "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80&auto=format&fit=crop",
        "alt": "Card image",
        "width": "100%",
        "height": "240px",
        "objectFit": "cover",
        "borderRadius": "18px"
      },
      "copy": {
        "type": "elementGroup",
        "display": "flex",
        "flow": "column",
        "gap": "0.55rem",
        "padding": "0.75rem 0.5rem 0.4rem",
        "section": {
          "elementOrder": ["kicker", "title", "body"],
          "definitions": {
            "kicker": {
              "preset": "type-kicker-badge",
              "text": "Feature"
            },
            "title": {
              "preset": "type-h4-card",
              "text": "Image-forward card"
            },
            "body": {
              "preset": "type-body-fine",
              "text": "Media above, copy below. The image crops cleanly to the card radius."
            }
          }
        }
      }
    }
  }
}
