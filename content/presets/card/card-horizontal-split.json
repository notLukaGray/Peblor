{
  "type": "elementGroup",
  "display": "flex",
  "flow": {
    "base": "column",
    "md": "row"
  },
  "align": {
    "base": "start",
    "md": "center"
  },
  "gap": "1rem",
  "width": "100%",
  "padding": "1.1rem",
  "borderRadius": "18px",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
  },
  "motion": {
    "onHover": {
      "y": -3
    },
    "transition": {
      "duration": 0.18
    }
  },
  "section": {
    "elementOrder": ["media", "copy"],
    "definitions": {
      "media": {
        "type": "elementGroup",
        "width": {
          "base": "100%",
          "md": "80px"
        },
        "height": {
          "base": "140px",
          "md": "80px"
        },
        "flex": {
          "base": "0 0 auto",
          "md": "0 0 80px"
        },
        "borderRadius": "12px",
        "scroll": "hidden",
        "fill": "color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)",
        "section": {
          "elementOrder": ["img"],
          "definitions": {
            "img": {
              "type": "elementImage",
              "src": "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&q=80&auto=format&fit=crop",
              "alt": "Card media",
              "width": "100%",
              "height": "100%",
              "objectFit": "cover"
            }
          }
        }
      },
      "copy": {
        "type": "elementGroup",
        "display": "flex",
        "flow": "column",
        "gap": "0.4rem",
        "flex": "1 1 0",
        "section": {
          "elementOrder": ["title", "body", "link"],
          "definitions": {
            "title": {
              "preset": "type-h4-card",
              "text": "Horizontal card title"
            },
            "body": {
              "preset": "type-body-fine",
              "text": "Media left, copy right. Stacks on mobile. Same shell idea as media-top — different slot layout."
            },
            "link": {
              "preset": "type-link-nav",
              "label": "View →",
              "href": "#"
            }
          }
        }
      }
    }
  }
}
