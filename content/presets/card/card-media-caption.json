{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "gap": "0.75rem",
  "width": "100%",
  "padding": "0.75rem",
  "borderRadius": "24px",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, transparent)",
  "section": {
    "elementOrder": ["image", "meta-row", "caption"],
    "definitions": {
      "image": {
        "type": "elementImage",
        "src": "https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=800&q=80&auto=format&fit=crop",
        "alt": "Card screenshot",
        "width": "100%",
        "height": "200px",
        "objectFit": "cover",
        "borderRadius": "16px"
      },
      "meta-row": {
        "type": "elementGroup",
        "display": "flex",
        "flow": "row",
        "distribute": "between",
        "align": "center",
        "padding": "0 0.15rem",
        "section": {
          "elementOrder": ["tag", "date"],
          "definitions": {
            "tag": {
              "preset": "type-kicker-badge",
              "text": "Screenshot"
            },
            "date": {
              "preset": "type-body-fine",
              "text": "May 2026"
            }
          }
        }
      },
      "caption": {
        "preset": "type-body-fine",
        "text": "Screenshot card with tag, date, and caption meta row below the image.",
        "textAlign": "center",
        "width": "100%"
      }
    }
  }
}
