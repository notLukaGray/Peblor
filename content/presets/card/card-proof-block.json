{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "gap": "1rem",
  "width": "100%",
  "padding": {
    "base": "1.25rem",
    "md": "1.75rem"
  },
  "borderRadius": "22px",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 5%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
  },
  "section": {
    "elementOrder": ["quote", "divider", "attribution"],
    "definitions": {
      "quote": {
        "preset": "type-h4-card",
        "text": "\"The kind of quality you notice immediately, and appreciate more over time.\""
      },
      "divider": {
        "type": "elementDivider",
        "width": "100%",
        "height": "1px",
        "fill": "color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
      },
      "attribution": {
        "type": "elementGroup",
        "display": "flex",
        "flow": "row",
        "wrap": "wrap",
        "align": "center",
        "gap": "0.75rem",
        "section": {
          "elementOrder": ["name", "role"],
          "definitions": {
            "name": {
              "preset": "type-h5-meta",
              "text": "Person Name"
            },
            "role": {
              "preset": "type-body-fine",
              "text": "Title, Company"
            }
          }
        }
      }
    }
  }
}
