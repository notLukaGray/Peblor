            "y": -4
          },
          "transition": {
            "duration": 0.18
          }
        },
        "section": {
          "elementOrder": ["kicker", "title", "body"],
          "definitions": {
            "kicker": {
              "preset": "type-kicker-badge",
              "text": "System"
            },
            "title": {
              "preset": "type-h4-card",
              "text": "Flex-wrap bento"
            },
            "body": {
              "preset": "type-body-fine",
              "text": "Bento uses flex-wrap, not CSS grid. Width on each child drives the layout."
            }
          }
        }
      },
      "bento-eq3": {
