        "section": {
          "elementOrder": ["kicker", "title", "body"],
          "definitions": {
            "kicker": {
              "preset": "type-kicker-badge",
              "text": "CTA"
            },
            "title": {
              "preset": "type-h4-card",
              "text": "Mixed card types"
            },
            "body": {
