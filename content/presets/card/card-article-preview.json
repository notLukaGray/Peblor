{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "align": "start",
  "gap": "0.85rem",
  "width": "100%",
  "padding": "1.1rem 0",
  "section": {
    "elementOrder": ["meta", "divider", "title", "excerpt", "link"],
    "definitions": {
      "meta": {
        "preset": "type-h5-meta",
        "text": "Article · 04 min"
      },
      "divider": {
        "preset": "card-divider"
      },
      "title": {
        "preset": "type-h4-card",
        "text": "Article preview title"
      },
      "excerpt": {
        "preset": "type-body-fine",
        "text": "A compact excerpt that previews the article content without giving it all away."
      },
      "link": {
        "preset": "type-link-inline",
        "label": "Read more",
        "href": "#"
      }
    }
  }
}
