{
  "type": "sectionColumn",
  "columns": {
    "base": 1,
    "md": 2
  },
  "columnWidths": {
    "base": [1],
    "md": [1, 2.5]
  },
  "columnGaps": {
    "base": "1.25rem",
    "md": "2.5rem"
  },
  "columnAssignments": {
    "rail": 0,
    "body": 1
  },
  "contentWidth": "100%",
  "contentHeight": "hug",
  "elementOrder": ["rail", "body"],
  "gridMode": "grid",
  "gridAutoRows": "auto",
  "definitions": {
    "rail": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "gap": "0.85rem",
      "height": "hug",
      "fill": "color-mix(in oklab, var(--pb-on-secondary) 5%, transparent)",
      "padding": {
        "base": "1.25rem",
        "md": "1.5rem"
      },
      "borderRadius": "14px",
      "wrapperStyle": {
        "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
      },
      "section": {
        "elementOrder": ["kicker", "title", "body", "link"],
        "definitions": {
          "kicker": {
            "preset": "type-body-mono",
            "text": "Utility"
          },
          "title": {
            "preset": "type-h4-card",
            "text": "Rail"
          },
          "body": {
            "preset": "type-body-fine",
            "text": "Pinned utility lane for metadata."
          },
          "link": {
            "preset": "type-link-nav",
            "label": "Open ->",
            "href": "#"
          }
        }
      }
    },
    "body": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "gap": "1.5rem",
      "height": "hug",
      "padding": "0",
      "section": {
        "elementOrder": ["article-a", "article-b", "article-c"],
        "definitions": {
          "article-a": {
            "preset": "card-article-preview",
            "section": {
              "elementOrder": ["title", "excerpt"],
              "definitions": {
                "title": {
                  "preset": "type-h4-card",
                  "text": "Article A"
                },
                "excerpt": {
                  "preset": "type-body-fine",
                  "text": "Narrative stream content with clean reading measure."
                }
              }
            }
          },
          "article-b": {
            "preset": "card-article-preview",
            "section": {
              "elementOrder": ["title", "excerpt"],
              "definitions": {
                "title": {
                  "preset": "type-h4-card",
                  "text": "Article B"
                },
                "excerpt": {
                  "preset": "type-body-fine",
                  "text": "Secondary narrative item."
                }
              }
            }
          },
          "article-c": {
            "preset": "card-article-preview",
            "section": {
              "elementOrder": ["title", "excerpt"],
              "definitions": {
                "title": {
                  "preset": "type-h4-card",
                  "text": "Article C"
                },
                "excerpt": {
                  "preset": "type-body-fine",
                  "text": "Tertiary narrative item."
                }
              }
            }
          }
        }
      }
    }
  }
}
