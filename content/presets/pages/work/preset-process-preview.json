{
  "preset": "work-preview-card",
  "visibleWhen": {
    "variable": "selectedProject",
    "operator": "equals",
    "value": "process"
  },
  "section": {
    "elementOrder": ["preview-image-wrap", "preview-content"],
    "definitions": {
      "preview-image-wrap": {
        "preset": "work-preview-image-wrap",
        "section": {
          "elementOrder": ["preview-image"],
          "definitions": {
            "preview-image": {
              "preset": "work-preview-image",
              "src": "work/project-process/process-spread.webp"
            }
          }
        }
      },
      "preview-content": {
        "preset": "work-preview-content",
        "section": {
          "elementOrder": ["preview-title", "preview-desc", "preview-cta"],
          "definitions": {
            "preview-title": {
              "preset": "work-preview-title",
              "text": "Vessel \u2014 Product Design"
            },
            "preview-desc": {
              "preset": "work-preview-desc",
              "text": "Full design process for Vessel, a personal finance app \u2014 research through production across twelve weeks with a four-person team."
            },
            "preview-cta": {
              "preset": "work-preview-cta",
              "label": "View project",
              "href": "/work/project-process"
            }
          }
        }
      }
    }
  }
}
