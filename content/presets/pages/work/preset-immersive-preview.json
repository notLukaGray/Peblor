{
  "preset": "work-preview-card",
  "visibleWhen": {
    "variable": "selectedProject",
    "operator": "equals",
    "value": "immersive"
  },
  "section": {
    "elementOrder": ["preview-image-wrap", "preview-content"],
    "definitions": {
      "preview-image-wrap": {
        "preset": "work-preview-image-wrap",
        "section": {
          "elementOrder": ["preview-image"],
          "definitions": {
            "preview-image": {
              "preset": "work-preview-image",
              "src": "work/project-immersive/immersive-overview.webp"
            }
          }
        }
      },
      "preview-content": {
        "preset": "work-preview-content",
        "section": {
          "elementOrder": ["preview-title", "preview-desc", "preview-cta"],
          "definitions": {
            "preview-title": {
              "preset": "work-preview-title",
              "text": "Threshold \u2014 Installation"
            },
            "preview-desc": {
              "preset": "work-preview-desc",
              "text": "A multi-sensory spatial installation exploring the boundary between physical and digital presence."
            },
            "preview-cta": {
              "preset": "work-preview-cta",
              "label": "View project",
              "href": "/work/project-immersive"
            }
          }
        }
      }
    }
  }
}
