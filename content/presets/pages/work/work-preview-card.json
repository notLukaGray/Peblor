{
  "type": "elementGroup",
  "width": "100%",
  "height": {
    "base": "auto",
    "md": "hug"
  },
  "flex": {
    "base": "1 1 0",
    "md": "0 0 auto"
  },
  "display": "flex",
  "flow": "column",
  "align": {
    "base": "center",
    "md": "start"
  },
  "gap": "0",
  "padding": "0",
  "borderRadius": "1.5rem",
  "scroll": "hidden",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, var(--pb-secondary))",
  "wrapperStyle": {
    "width": "100%",
    "display": "flex"
  },
  "motion": {
    "from": {
      "opacity": 0,
      "y": 10
    },
    "to": {
      "opacity": 1,
      "y": 0
    },
    "transition": {
      "duration": 0.45,
      "ease": "easeOut"
    }
  }
}
