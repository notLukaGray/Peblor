{
  "preset": "work-bg-overlay",
  "fill": "radial-gradient(ellipse 140% 120% at 62% 50%, oklch(0.85 0.03 25 / 0.55) 0%, oklch(0.85 0.01 25 / 0.08) 100%)",
  "visibleWhen": {
    "variable": "selectedProject",
    "operator": "equals",
    "value": "photography"
  },
  "motion": {
    "from": {
      "opacity": 0
    },
    "to": {
      "opacity": 1
    },
    "transition": {
      "duration": 1.1,
      "ease": "easeInOut"
    }
  }
}
