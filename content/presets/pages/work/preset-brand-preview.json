{
  "preset": "work-preview-card",
  "visibleWhen": {
    "variable": "selectedProject",
    "operator": "equals",
    "value": "brand"
  },
  "section": {
    "elementOrder": ["preview-image-wrap", "preview-content"],
    "definitions": {
      "preview-image-wrap": {
        "preset": "work-preview-image-wrap",
        "section": {
          "elementOrder": ["preview-image"],
          "definitions": {
            "preview-image": {
              "preset": "work-preview-image",
              "src": "work/project-brand/mark.webp"
            }
          }
        }
      },
      "preview-content": {
        "preset": "work-preview-content",
        "section": {
          "elementOrder": ["preview-title", "preview-desc", "preview-cta"],
          "definitions": {
            "preview-title": {
              "preset": "work-preview-title",
              "text": "NOMA \u2014 Brand Identity"
            },
            "preview-desc": {
              "preset": "work-preview-desc",
              "text": "Full brand identity for NOMA, a small-batch Norwegian aquavit distillery \u2014 mark, type, colour, and guidelines from first principles."
            },
            "preview-cta": {
              "preset": "work-preview-cta",
              "label": "View project",
              "href": "/work/project-brand"
            }
          }
        }
      }
    }
  }
}
