{
  "type": "backgroundTransition",
  "from": {
    "type": "backgroundVideo",
    "video": "https://www.w3schools.com/html/mov_bbb.mp4",
    "poster": "https://images.unsplash.com/photo-1536240478700-b869070f9279?w=1200&q=80",
    "overlay": "color-mix(in oklab, var(--pb-secondary) 40%, transparent)"
  },
  "to": {
    "type": "backgroundVariable",
    "layers": [
      {
        "fill": "var(--pb-secondary)"
      },
      {
        "fill": "radial-gradient(ellipse 100% 60% at 50% 0%, color-mix(in oklab, var(--pb-primary) 16%, transparent) 0%, transparent 70%)"
      }
    ]
  },
  "mode": "progress",
  "easing": "easeInOut",
  "progressRange": {
    "start": 0.2,
    "end": 0.5
  }
}
