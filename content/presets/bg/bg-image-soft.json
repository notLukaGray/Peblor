{
  "type": "backgroundVariable",
  "layers": [
    {
      "fill": "linear-gradient(180deg, color-mix(in oklab, var(--pb-accent) 9%, transparent) 0%, color-mix(in oklab, var(--pb-secondary) 42%, transparent) 100%)",
      "motion": [
        {
          "type": "loop",
          "to": {
            "opacity": [0.7, 1.0, 0.7]
          },
          "transition": {
            "duration": 7,
            "ease": "easeInOut",
            "repeatType": "mirror"
          }
        }
      ]
    },
    {
      "fill": "url(https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80)",
      "backgroundSize": "180%",
      "backgroundPosition": "center 50%",
      "backgroundRepeat": "no-repeat",
      "motion": [
        {
          "type": "parallax",
          "speed": 0.25,
          "axis": "y"
        }
      ]
    }
  ]
}
