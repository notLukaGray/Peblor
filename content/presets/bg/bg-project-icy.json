{
  "type": "backgroundVariable",
  "layers": [
    {
      "fill": "var(--pb-secondary)"
    },
    {
      "fill": "radial-gradient(ellipse 100% 62% at 50% 0%, color-mix(in oklab, var(--pb-primary) 17%, transparent) 0%, transparent 70%)",
      "motion": [
        {
          "type": "entrance",
          "from": {
            "opacity": 0
          },
          "to": {
            "opacity": 1
          },
          "transition": {
            "duration": 2.0,
            "ease": "easeOut"
          },
          "trigger": "onMount"
        }
      ]
    }
  ]
}
