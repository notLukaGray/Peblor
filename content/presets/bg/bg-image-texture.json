{
  "type": "backgroundVariable",
  "layers": [
    {
      "fill": "linear-gradient(180deg, color-mix(in oklab, var(--pb-primary) 13%, transparent) 0%, color-mix(in oklab, var(--pb-secondary) 52%, transparent) 100%)"
    },
    {
      "fill": "url(https://images.unsplash.com/photo-1541701494587-cb58502866ab?w=1600&q=80)",
      "backgroundSize": "cover",
      "backgroundPosition": "center",
      "motion": [
        {
          "type": "entrance",
          "from": {
            "scale": 1.08
          },
          "to": {
            "scale": 1
          },
          "transition": {
            "duration": 2.8,
            "ease": "easeOut"
          },
          "trigger": "onMount"
        }
      ]
    }
  ]
}
