{
  "type": "elementTooltip",
  "content": "A named definition block in a preset JSON file — reference it anywhere with \"preset\": \"key-name\".",
  "triggerLabel": "preset definition",
  "trigger": "hover",
  "placement": "top",
  "showDelay": 100,
  "hideDelay": 200,
  "interactive": true,
  "arrow": true,
  "fill": "color-mix(in oklab, var(--pb-secondary) 95%, transparent)",
  "bgBlur": "blur(12px)",
  "color": "var(--pb-on-secondary)",
  "borderRadius": "8px",
  "padding": "0.5rem 0.75rem",
  "fontSize": "13px",
  "motion": {
    "from": {
      "opacity": 0
    },
    "to": {
      "opacity": 1,
      "transition": {
        "duration": 0.35,
        "ease": "easeOut"
      }
    },
    "leave": {
      "opacity": 0,
      "transition": {
        "duration": 0.2,
        "ease": "easeIn"
      }
    }
  },
  "constraints": {
    "maxWidth": "260px"
  }
}
