{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "flex": "1 1 280px",
  "padding": "1.5rem",
  "borderRadius": "18px",
  "gap": "0.75rem",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
  },
  "motion": {
    "onHover": {
      "y": -4
    },
    "transition": {
      "duration": 0.18
    }
  },
  "section": {
    "elementOrder": ["cat-title", "cat-desc", "cat-link"],
    "definitions": {
      "cat-title": {
        "type": "elementHeading",
        "level": 4,
        "color": "var(--pb-on-secondary)",
        "text": ""
      },
      "cat-desc": {
        "type": "elementBody",
        "level": 5,
        "color": "color-mix(in oklab, var(--pb-on-secondary) 50%, transparent)",
        "text": ""
      },
      "cat-link": {
        "type": "elementLink",
        "label": "",
        "href": "#",
        "copyType": "body",
        "level": 5,
        "linkDefault": "var(--pb-accent)",
        "linkHover": "var(--pb-on-secondary)",
        "padding": "0"
      }
    }
  },
  "constraints": {
    "minWidth": "240px"
  }
}
