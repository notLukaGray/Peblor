                  "info-text": {
                    "type": "elementGroup",
                    "display": "flex",
                    "flow": "column",
                    "gap": "0.15rem",
                    "flex": "1",
                    "section": {
                      "elementOrder": ["track-title", "track-hint"],
                      "definitions": {
                        "track-title": {
                          "type": "elementBody",
                          "level": 4,
                          "text": "No track selected",
                          "color": "color-mix(in oklab, var(--pb-text-primary) 55%, transparent)"
                        },
                        "track-hint": {
                          "type": "elementBody",
                          "level": 5,
                          "text": "Tap to browse",
                          "color": "color-mix(in oklab, var(--pb-on-secondary) 38%, transparent)"
