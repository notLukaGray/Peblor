                  {
                    "variable": "activeTrack",
                    "operator": "notEquals",
                    "value": "track-2"
                  },
                  {
                    "variable": "activeTrack",
                    "operator": "notEquals",
                    "value": "track-3"
                  }
                ],
                "logic": "and"
              },
              "section": {
                "elementOrder": ["art-thumb", "info-text", "expand-btn", "close-btn"],
