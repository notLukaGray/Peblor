                      }
                    }
                  },
                  "expand-btn": {
                    "preset": "player-playlist-expand-btn"
                  },
                  "close-btn": {
                    "preset": "player-playlist-close-btn"
                  }
                }
              }
            },
            "info-t1": {
              "type": "elementGroup",
              "display": "flex",
              "flow": "row",
              "align": "center",
              "gap": "0.85rem",
              "padding": "0.85rem 1rem",
              "visibleWhen": {
