{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "align": "stretch",
  "gap": "0",
  "width": "100%",
  "height": "hug",
  "borderRadius": "18px",
  "scroll": "hidden",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 7%, transparent)",
  "wrapperStyle": {
