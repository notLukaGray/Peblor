              "level": 5,
              "wrapperPadding": "0.6rem 1.25rem",
              "wrapperBorderRadius": "0",
              "wrapperFill": "transparent",
              "wrapperFillHover": "color-mix(in oklab, var(--pb-on-secondary) 8%, transparent)",
