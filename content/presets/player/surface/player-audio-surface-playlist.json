              "type": "elementGroup",
              "display": "flex",
              "flow": "row",
              "align": "center",
              "gap": "0.85rem",
              "padding": "0.85rem 1rem",
              "visibleWhen": {
                "variable": "activeTrack",
                "operator": "equals",
                "value": "__never__"
              },
              "section": {
                "elementOrder": ["art-placeholder", "info-text", "expand-btn", "close-btn"],
                "definitions": {
                  "art-placeholder": {
                    "type": "elementGroup",
                    "width": "44px",
                    "height": "44px",
