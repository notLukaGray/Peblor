              "height": "60px",
              "display": "flex",
              "align": "center",
              "distribute": "center",
              "visibleWhen": {
                "variable": "activeTrack",
                "operator": "equals",
                "value": "__never__"
              },
              "section": {
                "elementOrder": ["hint"],
                "definitions": {
