{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "align": "stretch",
  "gap": "0",
  "width": "100%",
  "height": "hug",
  "borderRadius": "18px",
  "scroll": "hidden",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
  },
  "section": {
    "elementOrder": ["model-canvas", "model-controls"],
    "definitions": {
      "model-canvas": {
        "type": "elementModel3D",
        "id": "model-3d-mat",
        "width": "100%",
        "aspectRatio": "16 / 9",
        "initiallyLoaded": true,
        "models": {
          "mesh": {
            "geometry": "https://threejs.org/examples/models/gltf/LeePerrySmith/LeePerrySmith.glb"
          }
        },
        "canvas": {
          "dpr": 2,
          "gl": {
            "antialias": true,
            "powerPreference": "high-performance",
            "alpha": false
          }
        },
        "scene": {
          "camera": {
            "type": "perspective",
            "position": [0, 0, 2.8],
            "fov": 42,
            "near": 0.05,
            "far": 50
          },
          "background": {
            "type": "color",
            "color": "#050505"
          },
          "controls": {
            "mode": "orbit"
          },
          "cameraPresets": {
            "front": {
              "position": [0, 0, 2.8],
              "lookAt": [0, 0, 0],
              "fov": 42
            }
          },
          "cameraEffects": {
            "bobbing": {
              "amount": 0.08,
              "speed": 0.55
            },
            "mouseFollow": {
              "sensitivity": -0.07,
              "smoothness": 0.06,
              "desktopOnly": true
            }
          },
          "lights": [
            {
              "type": "ambient",
              "intensity": 0.12
            },
            {
              "type": "spot",
              "position": [1.5, 3, 2.5],
              "target": [0, 0, 0],
              "intensity": 3.8,
              "angle": 0.28,
              "penumbra": 0.4,
              "castShadow": true
            },
            {
              "type": "spot",
              "position": [-2, 0.5, 1.5],
              "target": [0, 0, 0],
              "intensity": 1.3,
              "angle": 0.42,
              "penumbra": 0.8,
              "color": "#ffe0b0"
            },
            {
              "type": "point",
              "position": [0, -2, 1],
              "intensity": 0.45,
              "color": "#2244bb",
              "distance": 4
            }
          ],
          "contents": {
            "models": [
              {
                "model": "mesh"
              }
            ]
          }
        },
        "postProcessing": [
          {
            "type": "ssao",
            "samples": 16,
            "radius": 0.08,
            "intensity": 1.5,
            "bias": 0.005,
            "disabledOnMobile": true
          },
          {
            "type": "bloom",
            "intensity": 0.75,
            "luminanceThreshold": 0.58,
            "radius": 0.5,
            "mipmapBlur": true
          },
          {
            "type": "brightnessContrast",
            "brightness": 0,
            "contrast": 0.3
          },
          {
            "type": "noise",
            "opacity": 0.04
          }
        ]
      },
      "model-controls": {
        "type": "elementGroup",
        "display": "flex",
        "flow": "row",
        "align": "center",
        "wrap": "wrap",
        "gap": "0.5rem",
        "padding": "0.75rem 1rem",
        "section": {
          "elementOrder": ["btn-front", "btn-orbit", "btn-reset"],
          "definitions": {
            "btn-front": {
              "type": "elementButton",
              "label": "Front",
              "action": "three.setCameraPreset",
              "actionPayload": {
                "id": "model-3d-mat",
                "preset": "front"
              },
              "level": 5,
              "wrapperPadding": "0.4rem 0.9rem",
              "wrapperBorderRadius": "10px",
              "wrapperFill": "color-mix(in oklab, var(--pb-accent) 15%, transparent)",
              "linkDefault": "var(--pb-on-secondary)",
              "motion": {
                "onHover": {
                  "scale": 1.04
                },
                "transition": {
                  "duration": 0.15
                }
              }
            },
            "btn-orbit": {
              "type": "elementButton",
              "label": "Auto-Rotate",
              "action": "three.orbitEnable",
              "actionPayload": {
                "id": "model-3d-mat",
                "autoRotate": true,
                "autoRotateSpeed": 0.8
              },
              "level": 5,
              "wrapperPadding": "0.4rem 0.9rem",
              "wrapperBorderRadius": "10px",
              "wrapperFill": "color-mix(in oklab, var(--pb-primary) 18%, transparent)",
              "linkDefault": "var(--pb-on-secondary)",
              "motion": {
                "onHover": {
                  "scale": 1.04
                },
                "transition": {
                  "duration": 0.15
                }
              }
            },
            "btn-reset": {
              "type": "elementButton",
              "label": "Reset",
              "action": "three.resetCamera",
              "actionPayload": {
                "id": "model-3d-mat"
              },
              "level": 5,
              "wrapperPadding": "0.4rem 0.9rem",
              "wrapperBorderRadius": "10px",
              "wrapperFill": "color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)",
              "linkDefault": "var(--pb-on-secondary)",
              "motion": {
                "onHover": {
                  "scale": 1.04
                },
                "transition": {
                  "duration": 0.15
                }
              }
            }
          }
        }
      }
    }
  }
}
