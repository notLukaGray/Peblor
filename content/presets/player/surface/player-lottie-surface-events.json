{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "align": "stretch",
  "gap": "0",
  "width": "100%",
  "height": "hug",
  "borderRadius": "18px",
  "scroll": "hidden",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
  },
  "section": {
    "elementOrder": ["lottie-canvas", "state-readout"],
    "definitions": {
      "lottie-canvas": {
        "type": "elementLottie",
        "src": "https://assets9.lottiefiles.com/packages/lf20_u4yrau.json",
        "autoplay": true,
        "loop": false,
        "width": "100%",
        "aspectRatio": "4 / 3",
        "onComplete": {
          "type": "setVariable",
          "payload": {
            "key": "lottieStatus",
            "value": "done"
          }
        },
        "onLoop": {
          "type": "setVariable",
          "payload": {
            "key": "lottieStatus",
            "value": "looping"
          }
        }
      },
      "state-readout": {
        "preset": "player-variable-panel"
      }
    }
  }
}
