{
  "type": "elementGroup",
  "display": "flex",
  "flow": "column",
  "align": "stretch",
  "gap": "0",
  "width": "100%",
  "height": "hug",
  "borderRadius": "18px",
  "scroll": "hidden",
  "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
  "wrapperStyle": {
    "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
  },
  "section": {
    "elementOrder": ["rive-canvas", "state-readout"],
    "definitions": {
      "rive-canvas": {
        "type": "elementRive",
        "id": "rive-player-minimal",
        "src": "https://cdn.rive.app/animations/vehicles.riv",
        "autoplay": true,
        "loop": true,
        "hover": true,
        "width": "100%",
        "aspectRatio": "1 / 1",
        "onStateChange": {
          "type": "setVariable",
          "payload": {
            "key": "riveState",
            "value": "$event.stateName"
          }
        },
        "onComplete": {
          "type": "setVariable",
          "payload": {
            "key": "riveStatus",
            "value": "complete"
          }
        }
      },
      "state-readout": {
        "preset": "player-variable-panel"
      }
    }
  }
}
