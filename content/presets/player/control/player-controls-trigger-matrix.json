          }
        }
      },
      "btn-seek-start": {
        "type": "elementButton",
        "label": "Seek 0s",
        "action": "assetSeek",
        "actionPayload": {
          "time": 0
        },
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
