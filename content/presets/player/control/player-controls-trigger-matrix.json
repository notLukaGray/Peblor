{
  "type": "elementGroup",
  "display": "flex",
  "flow": "row",
  "wrap": "wrap",
  "align": "center",
  "gap": "0.5rem",
  "padding": "0.75rem 0",
  "section": {
    "elementOrder": [
      "btn-play",
      "btn-pause",
      "btn-toggle",
      "btn-seek-back",
      "btn-seek-fwd",
      "btn-seek-start",
      "btn-mute",
      "btn-fullscreen"
    ],
    "definitions": {
      "btn-play": {
        "type": "elementButton",
        "label": "Play",
        "action": "assetPlay",
        "actionPayload": {},
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)",
        "linkDefault": "var(--pb-on-secondary)",
        "motion": {
          "onHover": {
            "scale": 1.04
          },
          "transition": {
            "duration": 0.15
          }
        }
      },
      "btn-pause": {
        "type": "elementButton",
        "label": "Pause",
        "action": "assetPause",
        "actionPayload": {},
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)",
        "linkDefault": "var(--pb-on-secondary)",
        "motion": {
          "onHover": {
            "scale": 1.04
          },
          "transition": {
            "duration": 0.15
          }
        }
      },
      "btn-toggle": {
        "type": "elementButton",
        "label": "Toggle",
        "action": "assetTogglePlay",
        "actionPayload": {},
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)",
