        "actionPayload": {
          "time": -5
        },
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)",
