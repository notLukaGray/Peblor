            "duration": 0.15
          }
        }
      },
      "btn-seek-fwd": {
        "type": "elementButton",
        "label": "Seek +5s",
        "action": "assetSeek",
        "actionPayload": {
          "time": 5
        },
        "level": 5,
        "wrapperPadding": "0.5rem 0.9rem",
        "wrapperBorderRadius": "10px",
