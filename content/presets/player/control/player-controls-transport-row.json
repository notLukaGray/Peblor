{
  "type": "elementGroup",
  "display": "flex",
  "flow": "row",
  "align": "center",
  "gap": "0.5rem",
  "padding": "0.4rem 0",
  "section": {
    "elementOrder": ["btn-play"],
    "definitions": {
      "btn-play": {
        "type": "elementButton",
        "label": "⏯",
        "action": "assetTogglePlay",
        "actionPayload": {},
        "wrapperPadding": "0.6rem",
        "wrapperBorderRadius": "999px",
        "wrapperFill": "var(--pb-on-secondary)",
        "level": 5,
        "motion": {
          "onHover": {
            "scale": 1.08
          },
          "transition": {
            "duration": 0.15
          }
        }
      }
    }
  }
}
