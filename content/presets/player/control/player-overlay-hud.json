{
  "type": "elementGroup",
  "display": "flex",
  "flow": "row",
  "align": "center",
  "gap": "0.75rem",
  "padding": "0.75rem 1.25rem",
  "borderRadius": "16px",
  "fill": "color-mix(in oklab, var(--pb-secondary) 88%, transparent)",
  "bgBlur": "blur(20px)",
  "wrapperStyle": {
    "position": "absolute",
    "bottom": "1rem",
    "left": "1rem",
    "right": "1rem"
  },
  "section": {
    "elementOrder": ["transport", "seek-cluster", "state-chips"],
    "definitions": {
      "transport": {
        "preset": "player-controls-transport-full"
      },
      "seek-cluster": {
        "preset": "player-controls-seek-cluster"
      },
      "state-chips": {
        "preset": "player-controls-state-chip"
      }
    }
  }
}
