{
  "type": "divider",
  "height": {
    "base": "4rem",
    "md": "6rem"
  },
  "width": "100%",
  "minHeight": "3rem",
  "fill": "surfaceSecondary",
  "border": {
    "top": {
      "width": "1px",
      "color": "borderSubtle",
      "style": "solid"
    }
  },
  "effects": [
