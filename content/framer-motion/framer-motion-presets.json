{
  "entrancePresets": {
    "fade": {
      "from": {
        "opacity": 0
      },
      "to": {
        "opacity": 1
      }
    },
    "slideUp": {
      "from": {
        "y": 24
      },
      "to": {
        "y": 0
      }
    },
    "slideDown": {
      "from": {
        "y": -24
      },
      "to": {
        "y": 0
      }
    },
    "slideLeft": {
      "from": {
        "x": 24
      },
      "to": {
        "x": 0
      }
    },
    "slideRight": {
      "from": {
        "x": -24
      },
      "to": {
        "x": 0
      }
    },
    "zoomIn": {
      "from": {
        "scale": 0.92
      },
      "to": {
        "scale": 1
      }
    },
    "zoomOut": {
      "from": {
        "scale": 1.08
      },
      "to": {
        "scale": 1
      }
    },
    "popIn": {
      "from": {
        "opacity": 0,
        "scale": 0.86,
        "y": 10
      },
      "to": {
        "opacity": 1,
        "scale": 1,
        "y": 0
      }
    },
    "blurIn": {
      "from": {
        "opacity": 0,
        "filter": "blur(8px)"
      },
      "to": {
        "opacity": 1,
        "filter": "blur(0px)"
      }
    },
    "tiltIn": {
      "from": {
        "rotate": -4
      },
      "to": {
        "rotate": 0
      }
    }
  },
  "exitPresets": {
    "fade": {
      "leave": {
        "opacity": 0
      }
    },
    "slideUp": {
      "leave": {
        "y": -24
      }
    },
    "slideDown": {
      "leave": {
        "y": 24
      }
    },
    "slideLeft": {
      "leave": {
        "x": -24
      }
    },
    "slideRight": {
      "leave": {
        "x": 24
      }
    },
    "zoomIn": {
      "leave": {
        "scale": 1.08
      }
    },
    "zoomOut": {
      "leave": {
        "scale": 0.92
      }
    },
    "popIn": {
      "leave": {
        "opacity": 0,
        "scale": 0.92,
        "y": 8
      }
    },
    "blurIn": {
      "leave": {
        "opacity": 0,
        "filter": "blur(8px)"
      }
    },
    "tiltIn": {
      "leave": {
        "rotate": 4
      }
    }
  }
}
