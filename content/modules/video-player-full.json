{
  "type": "module",
  "contextType": "video",
  "contentSlot": "main",
  "container": {
    "padding": "10px",
    "borderRadius": "20px"
  },
  "behavior": {
    "sleepAfterMs": 3000,
    "sleepFadeMs": 500,
    "controlsTransitionMs": 500,
    "controlsTransitionEasing": "easeOut",
    "transitionEasing": "easeOut",
    "feedbackDurationMs": 100
  },
  "keyBindings": [
    {
      "key": "Space",
      "action": "assetTogglePlay"
    },
    {
      "key": "KeyK",
      "action": "assetTogglePlay"
    },
    {
      "key": "ArrowLeft",
      "action": "assetSeek",
      "payload": -5
    },
    {
      "key": "KeyJ",
      "action": "assetSeek",
      "payload": -5
    },
    {
      "key": "ArrowRight",
      "action": "assetSeek",
      "payload": 5
    },
    {
      "key": "KeyL",
      "action": "assetSeek",
      "payload": 5
    },
    {
      "key": "KeyM",
      "action": "assetMute"
    },
    {
      "key": "KeyF",
      "action": "videoFullscreen"
    }
  ],
  "overlayMotion": {
    "from": {
      "opacity": 0
    },
    "to": {
      "opacity": 1
    },
    "transition": {
      "duration": 0.5,
      "ease": "easeOut"
    },
    "onHover": {},
    "onPress": {
      "scale": 1,
      "opacity": 1
    },
    "onFocus": {
      "opacity": 1
    }
  },
  "slots": {
    "main": {
      "position": "absolute",
      "inset": "0",
      "layer": 0
    },
    "surfaceToggle": {
      "position": "absolute",
      "inset": "0",
      "layer": 1,
      "action": "assetTogglePlay",
      "style": {
        "background": "transparent"
      },
      "section": {
        "elementOrder": [],
        "definitions": {}
      }
    },
    "centerPlay": {
      "position": "absolute",
      "top": "50%",
      "left": "50%",
      "layer": 5,
      "align": "center",
      "distribute": "center",
      "padding": "0",
      "transformInherit": "disable",
      "slotWrapperGestures": false,
      "visibleWhen": ["assetPaused"],
      "style": {
        "width": "80px",
        "height": "80px",
        "marginLeft": "-40px",
        "marginTop": "-40px",
        "background": "#00000020",
        "borderRadius": "9999px"
      },
      "effects": [
        {
          "type": "glass",
          "bezelType": "convex_squircle",
          "bezelWidth": 24,
          "glassThickness": 20,
          "refractiveIndex": 1.8,
          "blur": 1,
          "scaleRatio": 1,
          "specularOpacity": 0.5,
          "specularSaturation": 5,
          "magnifyingScale": 0.5,
          "dropShadow": true
        }
      ],
      "section": {
        "elementOrder": ["play-btn"],
        "definitions": {
          "play-btn": {
            "preset": "video-controls-play",
            "width": "28px",
            "height": "32px",
            "showWhen": "assetPaused",
            "action": "assetTogglePlay",
            "wrapperStyle": {
              "transform": "translateX(2px)"
            }
          }
        }
      }
    },
    "bottomBar": {
      "position": "absolute",
      "bottom": "calc(10px + env(safe-area-inset-bottom, 0px))",
      "left": "10px",
      "right": "10px",
      "layer": 10,
      "paddingBottom": "10px",
      "display": "flex",
      "flow": "row",
      "align": "center",
      "distribute": "start",
      "height": "44px",
      "gap": "2px",
      "visibleWhen": ["awake"],
      "transformInherit": "disable",
      "slotWrapperGestures": false,
      "wrapperMotion": {
        "onHover": {
          "opacity": 1
        },
        "onPress": {
          "opacity": 1
        },
        "onFocus": {
          "opacity": 1
        }
      },
      "defaultWrapperStyle": {
        "width": "44px",
        "height": "44px",
        "minWidth": "44px",
        "minHeight": "44px",
        "align": "center",
        "distribute": "center",
        "flexShrink": "0"
      },
      "style": {
        "background": "#00000020",
        "borderRadius": "9999px"
      },
      "effects": [
        {
          "type": "glass",
          "bezelType": "convex_squircle",
          "bezelWidth": 24,
          "glassThickness": 20,
          "refractiveIndex": 1.8,
          "blur": 1,
          "scaleRatio": 1,
          "specularOpacity": 0.5,
          "specularSaturation": 5,
          "magnifyingScale": 0.5,
          "dropShadow": true
        }
      ],
      "section": {
        "elementOrder": ["left-controls", "seek-wrap", "right-controls"],
        "definitions": {
          "left-controls": {
            "type": "elementGroup",
            "width": "hug",
            "height": "44px",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "scroll": "visible",
            "padding": "0",
            "gap": "4px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["ui-play", "ui-pause", "volume"],
              "definitions": {
                "ui-play": {
                  "preset": "video-controls-play-bar",
                  "action": "assetTogglePlay",
                  "showWhen": "assetPaused",
                  "wrapperStyle": {
                    "transform": "translate(2px, 1px)"
                  }
                },
                "ui-pause": {
                  "preset": "video-controls-pause-bar",
                  "action": "assetTogglePlay",
                  "showWhen": "assetPlaying",
                  "wrapperStyle": {
                    "transform": "translateY(1px)"
                  }
                },
                "volume": {
                  "preset": "player-controls-volume-hover"
                }
              }
            },
            "constraints": {
              "minWidth": "96px"
            }
          },
          "seek-wrap": {
            "type": "elementGroup",
            "flex": "1",
            "height": "44px",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "distribute": "center",
            "padding": "0 16px 0 8px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "align": "center"
            },
            "section": {
              "elementOrder": ["seek"],
              "definitions": {
                "seek": {
                  "preset": "video-controls-seek",
                  "wrapperStyle": {
                    "width": "100%",
                    "height": "20px"
                  },
                  "width": "100%",
                  "height": "20px",
                  "style": {
                    "trackColor": "rgba(255,255,255,0.38)",
                    "fillColor": "#FFFFFF",
                    "trackHeight": "4px",
                    "thumbSize": "10px"
                  }
                }
              }
            },
            "constraints": {
              "minWidth": "0"
            }
          },
          "right-controls": {
            "type": "elementGroup",
            "width": "hug",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "distribute": "end",
            "gap": "4px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["time", "quality-select", "fullscreen", "minimize"],
              "definitions": {
                "time": {
                  "preset": "video-controls-time",
                  "paddingLeft": "4px",
                  "paddingRight": "10px"
                },
                "quality-select": {
                  "preset": "video-controls-quality-select"
                },
                "fullscreen": {
                  "preset": "video-controls-fullscreen-bar",
                  "action": "videoFullscreen",
                  "showWhen": "videoContained"
                },
                "minimize": {
                  "preset": "video-controls-minimize-bar",
                  "action": "videoFullscreen",
                  "showWhen": "videoFullscreen"
                }
              }
            }
          }
        }
      }
    }
  }
}
