{
  "type": "module",
  "contextType": "audio",
  "contentSlot": "main",
  "container": {
    "padding": "0",
    "borderRadius": "0",
    "minHeight": "64px",
    "aspectRatio": null,
    "background": "transparent"
  },
  "behavior": {
    "controlsTransitionMs": 400,
    "controlsTransitionEasing": "easeOut"
  },
  "keyBindings": [
    {
      "key": "Space",
      "action": "assetTogglePlay"
    },
    {
      "key": "KeyK",
      "action": "assetTogglePlay"
    },
    {
      "key": "KeyM",
      "action": "assetMute"
    }
  ],
  "slots": {
    "main": {
      "position": "relative",
      "layer": 0
    },
    "bottomBar": {
      "position": "absolute",
      "bottom": "8px",
      "left": "0",
      "right": "0",
      "layer": 10,
      "display": "flex",
      "flow": "row",
      "align": "center",
      "distribute": "start",
      "height": "44px",
      "gap": "8px",
      "padding": "0 12px",
      "transformInherit": "disable",
      "defaultWrapperStyle": {
        "width": "44px",
        "height": "44px",
        "minWidth": "44px",
        "minHeight": "44px",
        "align": "center",
        "distribute": "center",
        "flexShrink": "0"
      },
      "section": {
        "elementOrder": ["left-controls", "seek-wrap", "right-controls"],
        "definitions": {
          "left-controls": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "width": "hug",
            "height": "100%",
            "gap": "8px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["time-elapsed"],
              "definitions": {
                "time-elapsed": {
                  "type": "elementBody",
                  "text": "0:00",
                  "bindAudioCurrentTime": true,
                  "width": "hug",
                  "variant": "fine",
                  "color": "#FFFFFF"
                }
              }
            }
          },
          "seek-wrap": {
            "type": "elementGroup",
            "flex": "1",
            "height": "100%",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "distribute": "center",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "align": "center"
            },
            "section": {
              "elementOrder": ["seek"],
              "definitions": {
                "seek": {
                  "preset": "video-controls-seek",
                  "wrapperStyle": {
                    "width": "100%",
                    "height": "20px"
                  },
                  "width": "100%",
                  "height": "20px",
                  "style": {
                    "trackColor": "rgba(255,255,255,0.38)",
                    "fillColor": "#FFFFFF",
                    "trackHeight": "4px",
                    "thumbSize": "10px"
                  }
                }
              }
            },
            "constraints": {
              "minWidth": "0"
            }
          },
          "right-controls": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "width": "hug",
            "height": "100%",
            "gap": "8px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["time-total"],
              "definitions": {
                "time-total": {
                  "type": "elementBody",
                  "text": "0:00",
                  "bindAudioDuration": true,
                  "width": "hug",
                  "variant": "fine",
                  "color": "#FFFFFF"
                }
              }
            }
          }
        }
      }
    }
  }
}
