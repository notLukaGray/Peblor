{
  "type": "module",
  "contextType": "audio",
  "contentSlot": "main",
  "container": {
    "padding": "0",
    "borderRadius": "0",
    "aspectRatio": "4 / 3",
    "background": "transparent",
    "posterGradient": "linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 45%, transparent 100%)"
  },
  "behavior": {
    "controlsTransitionMs": 400,
    "controlsTransitionEasing": "easeOut"
  },
  "keyBindings": [
    {
      "key": "Space",
      "action": "assetTogglePlay"
    },
    {
      "key": "KeyK",
      "action": "assetTogglePlay"
    },
    {
      "key": "ArrowLeft",
      "action": "assetSeek",
      "payload": -5
    },
    {
      "key": "ArrowRight",
      "action": "assetSeek",
      "payload": 5
    },
    {
      "key": "KeyM",
      "action": "assetMute"
    }
  ],
  "slots": {
    "main": {
      "position": "relative",
      "layer": 0
    },
    "bottomBar": {
      "position": "absolute",
      "bottom": "8px",
      "left": "10px",
      "right": "10px",
      "layer": 10,
      "display": "flex",
      "flow": "row",
      "align": "center",
      "height": "44px",
      "gap": "8px",
      "padding": "0 12px",
      "transformInherit": "disable",
      "defaultWrapperStyle": {
        "width": "44px",
        "height": "44px",
        "minWidth": "44px",
        "minHeight": "44px",
        "align": "center",
        "distribute": "center",
        "flexShrink": "0"
      },
      "style": {
        "background": "#00000020",
        "borderRadius": "9999px"
      },
      "effects": [
        {
          "type": "glass",
          "bezelType": "convex_squircle",
          "bezelWidth": 24,
          "glassThickness": 20,
          "refractiveIndex": 1.8,
          "blur": 1,
          "scaleRatio": 1,
          "specularOpacity": 0.5,
          "specularSaturation": 5,
          "magnifyingScale": 0.5,
          "dropShadow": true
        }
      ],
      "section": {
        "elementOrder": ["left-controls", "seek-wrap", "right-controls"],
        "definitions": {
          "left-controls": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "scroll": "visible",
            "width": "hug",
            "height": "100%",
            "gap": "8px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["btn-play", "btn-pause", "volume"],
              "definitions": {
                "btn-play": {
                  "preset": "video-controls-play-bar",
                  "action": "assetTogglePlay",
                  "showWhen": "assetPaused",
                  "wrapperStyle": {
                    "borderRadius": "0",
                    "marginRight": "24px",
                    "transform": "translateX(2px)"
                  }
                },
                "btn-pause": {
                  "preset": "video-controls-pause-bar",
                  "action": "assetTogglePlay",
                  "showWhen": "assetPlaying",
                  "wrapperStyle": {
                    "borderRadius": "0",
                    "marginRight": "24px"
                  }
                },
                "volume": {
                  "preset": "player-controls-volume-hover"
                }
              }
            },
            "constraints": {
              "minWidth": "96px"
            }
          },
          "seek-wrap": {
            "type": "elementGroup",
            "flex": "1",
            "height": "100%",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "distribute": "center",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "align": "center"
            },
            "section": {
              "elementOrder": ["seek"],
              "definitions": {
                "seek": {
                  "preset": "video-controls-seek",
                  "wrapperStyle": {
                    "width": "100%",
                    "height": "20px"
                  },
                  "width": "100%",
                  "height": "20px",
                  "style": {
                    "trackColor": "rgba(255,255,255,0.38)",
                    "fillColor": "#FFFFFF",
                    "trackHeight": "4px",
                    "thumbSize": "10px"
                  }
                }
              }
            },
            "constraints": {
              "minWidth": "0"
            }
          },
          "right-controls": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "width": "hug",
            "height": "100%",
            "gap": "8px",
            "wrapperStyle": {
              "position": "relative",
              "layer": 1,
              "flexShrink": "0",
              "align": "center"
            },
            "section": {
              "elementOrder": ["time"],
              "definitions": {
                "time": {
                  "type": "elementBody",
                  "text": "0:00 / 0:00",
                  "bindAudioTransportTime": true,
                  "width": "hug",
                  "variant": "fine",
                  "color": "#FFFFFF"
                }
              }
            }
          }
        }
      }
    }
  }
}
