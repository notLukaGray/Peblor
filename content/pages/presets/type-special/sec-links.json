{
  "type": "contentBlock",
  "flow": "column",
  "align": "start",
  "width": {
    "base": "92%",
    "md": "72%"
  },
  "maxWidth": "820px",
  "selfAlign": "center",
  "padding": {
    "base": "0 0 5rem",
    "md": "0 0 8rem"
  },
  "gap": "3.5rem",
  "height": "hug",
  "motionTiming": {
    "staggerChildren": 0.15,
    "trigger": "onFirstVisible"
