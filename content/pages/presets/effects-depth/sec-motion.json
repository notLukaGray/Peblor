                "n": {
                  "preset": "type-body-mono",
                  "text": "03"
                },
                "t": {
                  "preset": "type-h4-card",
                  "text": "Blur In — focus snap from blurred to sharp. Lens-like reveal."
                }
              }
            }
          },
          "i4": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "padding": "1.25rem 1.75rem",
            "gap": "1.5rem",
            "borderRadius": "13px",
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-on-secondary) 5%, transparent)",
              "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 8%, transparent)"
            },
            "motionTiming": {
              "entrancePreset": "zoomIn",
              "trigger": "onFirstVisible",
              "viewport": {
                "amount": 0.2
              }
            },
            "section": {
              "elementOrder": ["n", "t"],
              "definitions": {
                "n": {
                  "preset": "type-body-mono",
                  "text": "04"
                },
                "t": {
                  "preset": "type-h4-card",
                  "text": "Zoom In — scale 0.95 to 1.0 with opacity. Subtle pop."
                }
              }
            }
          },
          "i5": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "padding": "1.25rem 1.75rem",
            "gap": "1.5rem",
            "borderRadius": "13px",
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-on-secondary) 5%, transparent)",
              "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 8%, transparent)"
            },
            "motionTiming": {
              "entrancePreset": "popIn",
              "trigger": "onFirstVisible",
              "viewport": {
                "amount": 0.2
              }
            },
            "section": {
              "elementOrder": ["n", "t"],
              "definitions": {
                "n": {
                  "preset": "type-body-mono",
                  "text": "05"
                },
                "t": {
                  "preset": "type-h4-card",
                  "text": "Pop In — scale + opacity + translateY. Combined entrance."
                }
              }
            }
          },
          "i6": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "row",
            "align": "center",
            "padding": "1.25rem 1.75rem",
            "gap": "1.5rem",
            "borderRadius": "13px",
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-on-secondary) 5%, transparent)",
              "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 8%, transparent)"
            },
            "motionTiming": {
              "entrancePreset": "fade",
              "trigger": "onFirstVisible",
              "viewport": {
                "amount": 0.2
              }
            },
            "section": {
              "elementOrder": ["n", "t"],
              "definitions": {
                "n": {
                  "preset": "type-body-mono",
                  "text": "06"
                },
                "t": {
                  "preset": "type-h4-card",
                  "text": "Fade (slow) — longer opacity ramp. A graceful closing note."
                }
              }
            }
          }
        }
      }
    }
  }
