{
  "type": "contentBlock",
  "flow": "column",
  "width": {
    "base": "92%",
    "md": "80%"
  },
  "maxWidth": "780px",
  "selfAlign": "center",
  "align": "center",
  "padding": {
    "base": "4rem 0 5rem",
    "md": "7rem 0 9rem"
  },
  "gap": "2.5rem",
  "height": "hug",
  "scroll": "visible",
  "motionTiming": {
    "entrancePreset": "fade",
    "trigger": "onFirstVisible"
  },
  "elementOrder": ["label", "desc", "stack"],
  "definitions": {
    "label": {
      "preset": "type-h3-label",
      "text": "Layered Atmosphere"
    },
    "desc": {
      "preset": "type-body-fine",
      "text": "Stacked translucent panels with progressive backdrop blur. Each overlapping layer adds spatial depth through increasing blur and opacity."
    },
    "stack": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "align": "center",
      "gap": "0",
      "width": "100%",
      "padding": "2rem 0 1rem",
      "section": {
        "elementOrder": ["deep", "frost", "clear"],
        "definitions": {
          "deep": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "align": "center",
            "textAlign": "center",
            "padding": "2.5rem 2rem",
            "gap": "0.65rem",
            "width": {
              "base": "100%",
              "md": "88%"
            },
            "borderRadius": "22px",
            "opacity": 0.45,
            "effects": [
              {
                "type": "backdropBlur",
                "amount": "3px"
              }
            ],
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-accent) 10%, transparent)"
            },
            "border": "1px solid color-mix(in oklab, var(--pb-accent) 12%, transparent)",
            "section": {
              "elementOrder": ["t", "d"],
              "definitions": {
                "t": {
                  "preset": "type-h4-card",
                  "text": "Ambient haze",
                  "color": "color-mix(in oklab, var(--pb-on-secondary) 55%, transparent)"
                },
                "d": {
                  "preset": "type-body-fine",
                  "text": "Subtle blur, low opacity. The deepest visible plane.",
                  "color": "color-mix(in oklab, var(--pb-on-secondary) 40%, transparent)"
                }
              }
            }
          },
          "frost": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "align": "center",
            "textAlign": "center",
            "padding": "2.5rem 2rem",
            "gap": "0.65rem",
            "width": {
              "base": "100%",
              "md": "94%"
            },
            "marginTop": "-2rem",
            "borderRadius": "22px",
            "opacity": 0.78,
            "effects": [
              {
                "type": "backdropBlur",
                "amount": "10px"
              }
            ],
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-on-secondary) 8%, transparent)"
            },
            "boxShadow": "0 6px 24px color-mix(in oklab, rgba(0,0,0) 10%, transparent)",
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)",
            "section": {
              "elementOrder": ["t", "d"],
              "definitions": {
                "t": {
                  "preset": "type-h4-card",
                  "text": "Frosted glass",
                  "color": "color-mix(in oklab, var(--pb-on-secondary) 85%, transparent)"
                },
                "d": {
                  "preset": "type-body-fine",
                  "text": "Backdrop blur, medium opacity. Translucent bridge between haze and surface.",
                  "color": "color-mix(in oklab, var(--pb-on-secondary) 62%, transparent)"
                }
              }
            }
          },
          "clear": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "align": "center",
            "textAlign": "center",
            "padding": "2.5rem 2rem",
            "gap": "0.65rem",
            "width": "100%",
            "marginTop": "-2rem",
            "borderRadius": "22px",
            "effects": [
              {
                "type": "backdropBlur",
                "amount": "20px"
              }
            ],
            "wrapperStyle": {
              "backgroundColor": "color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
            },
            "boxShadow": "0 12px 48px color-mix(in oklab, rgba(0,0,0) 14%, transparent), 0 3px 8px color-mix(in oklab, rgba(0,0,0) 8%, transparent)",
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 16%, transparent)",
            "section": {
              "elementOrder": ["t", "d"],
              "definitions": {
                "t": {
                  "preset": "type-h4-card",
                  "text": "Clear surface"
                },
                "d": {
                  "preset": "type-body-standard",
                  "text": "Full opacity, strongest blur, elevated shadow. The primary reading plane — crisp and luminous against the softer depth behind."
                }
              }
            }
          }
        }
      }
    }
  }
}
