{
  "type": "contentBlock",
  "width": {
    "base": "92%",
    "md": "72%"
  },
  "maxWidth": "900px",
  "selfAlign": "center",
  "padding": {
    "base": "0 0 8rem",
    "md": "0 0 10rem"
  },
  "elementOrder": ["reveal-group"],
  "definitions": {
    "reveal-group": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "align": "start",
      "gap": "0.75rem",
      "width": "100%",
      "disclosure": {
        "mode": "tap",
        "triggerKeys": ["reveal-teaser-trigger", "reveal-collapse"],
        "panelKeys": ["reveal-content", "reveal-collapse"],
        "collapsedStyle": {
          "maxHeight": "4.5rem"
        },
        "expandedStyle": {
          "maxHeight": "2000px"
        }
      },
      "section": {
        "elementOrder": ["reveal-teaser-trigger", "reveal-content", "reveal-collapse"],
        "definitions": {
          "reveal-teaser-trigger": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "align": "start",
            "width": "100%",
            "section": {
              "elementOrder": ["teaser-text"],
              "definitions": {
                "teaser-text": {
                  "preset": "type-body-standard",
                  "text": "This is the teaser — just the first line. Click to expand and read the full text below..."
                }
              }
            }
          },
          "reveal-content": {
            "preset": "type-rich-prose",
            "width": {
              "base": "100%",
              "md": "82%"
            }
          },
          "reveal-collapse": {
            "preset": "type-link-nav",
            "label": "Collapse ↑"
          }
        }
      }
    }
  }
}
