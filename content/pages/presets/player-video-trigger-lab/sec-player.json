{
  "preset": "player-section",
  "elementOrder": ["player-label", "player-surface"],
  "definitions": {
    "player-label": {
      "preset": "type-h3-label",
      "text": "Video Trigger Lab"
    },
    "player-surface": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "align": "stretch",
      "gap": "0",
      "width": "100%",
      "borderRadius": "18px",
      "scroll": "hidden",
      "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
      "wrapperStyle": {
        "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 12%, transparent)"
      },
      "section": {
        "elementOrder": ["video-area", "matrix-section"],
        "definitions": {
          "video-area": {
            "type": "elementGroup",
            "width": "100%",
            "aspectRatio": "16 / 9",
            "scroll": "hidden",
            "section": {
              "elementOrder": ["video"],
              "definitions": {
                "video": {
                  "type": "elementVideo",
                  "module": "video-player",
                  "src": "https://samplelib.com/preview/mp4/sample-5s.mp4",
                  "poster": "",
                  "width": "100%",
                  "height": "100%",
                  "objectFit": "cover"
                }
              }
            }
          },
          "matrix-section": {
            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "gap": "0.75rem",
            "padding": "1rem 1.25rem 1.25rem",
            "wrapperStyle": {
              "borderTop": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
            },
            "section": {
              "elementOrder": ["matrix-label", "matrix-grid"],
              "definitions": {
                "matrix-label": {
                  "preset": "type-h5-meta",
                  "text": "Action Matrix — all asset trigger actions"
                },
                "matrix-grid": {
                  "type": "elementGroup",
                  "display": "flex",
                  "flow": "row",
                  "wrap": "wrap",
                  "gap": "0.5rem",
                  "section": {
                    "elementOrder": [
                      "btn-play",
                      "btn-pause",
                      "btn-toggle",
                      "btn-seek-back",
                      "btn-seek-fwd",
                      "btn-seek-start",
                      "btn-seek-90",
                      "btn-mute",
                      "btn-fullscreen"
                    ],
                    "definitions": {
                      "btn-play": {
                        "preset": "player-demo-btn",
                        "label": "assetPlay",
                        "action": "assetPlay",
                        "actionPayload": {},
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-pause": {
                        "preset": "player-demo-btn",
                        "label": "assetPause",
                        "action": "assetPause",
                        "actionPayload": {},
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-toggle": {
                        "preset": "player-demo-btn",
                        "label": "assetTogglePlay",
                        "action": "assetTogglePlay",
                        "actionPayload": {},
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-seek-back": {
                        "preset": "player-demo-btn",
                        "label": "assetSeek −5s",
                        "action": "assetSeek",
                        "actionPayload": {
                          "time": -5
                        },
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-seek-fwd": {
                        "preset": "player-demo-btn",
                        "label": "assetSeek +5s",
                        "action": "assetSeek",
                        "actionPayload": {
                          "time": 5
                        },
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-seek-start": {
                        "preset": "player-demo-btn",
                        "label": "assetSeek 0s",
                        "action": "assetSeek",
                        "actionPayload": {
                          "time": 0
                        },
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-seek-90": {
                        "preset": "player-demo-btn",
                        "label": "assetSeek 90s",
                        "action": "assetSeek",
                        "actionPayload": {
                          "time": 90
                        },
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-mute": {
                        "preset": "player-demo-btn",
                        "label": "assetMute",
                        "action": "assetMute",
                        "actionPayload": {},
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      },
                      "btn-fullscreen": {
                        "preset": "player-demo-btn",
                        "label": "videoFullscreen",
                        "action": "videoFullscreen",
                        "actionPayload": {},
                        "wrapperFill": "color-mix(in oklab, var(--pb-accent) 18%, transparent)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
