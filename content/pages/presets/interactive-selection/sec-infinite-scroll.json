{
  "preset": "demo-section",
  "motionTiming": {
    "staggerChildren": 0.15,
    "trigger": "onFirstVisible"
  },
  "elementOrder": ["sec-label", "sec-desc", "scroll-cards"],
  "definitions": {
    "sec-label": {
      "preset": "type-h3-label",
      "text": "Infinite Scroll"
    },
    "sec-desc": {
      "preset": "type-body-fine",
      "text": "Horizontal infinite scroll carousel with snap alignment. Click or drag to navigate. Active card is full opacity and scale; inactive cards recede."
    },
    "scroll-cards": {
      "type": "elementInfiniteScroll",
      "scrollDirection": "horizontal",
      "snapAlign": "center",
      "activeScale": 1,
      "inactiveScale": 0.88,
      "activeOpacity": 1,
      "inactiveOpacity": 0.5,
      "gap": "1.5rem",
      "centerOnClick": true,
      "section": {
        "elementOrder": ["card-1", "card-2", "card-3", "card-4", "card-5"],
        "definitions": {
