            "type": "elementGroup",
            "display": "flex",
            "flow": "column",
            "padding": "2rem",
            "gap": "1rem",
            "width": "320px",
            "height": "hug",
            "borderRadius": "16px",
            "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)",
            "section": {
              "elementOrder": ["num", "title", "desc"],
              "definitions": {
