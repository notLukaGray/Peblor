{
  "contractVersion": "1.0.0",
  "title": "Portfolio — Composition Demo",
  "description": "Creative designer portfolio: dark hero, about split, bento project grid, process steps, video showreel, and contact CTA.",
  "presets": [
    "demo",
    "type/core",
    "type/effects",
    "type/motion",
    "ui/button",
    "ui/link",
    "layout",
    "card",
    "bg"
  ],
  "bgKey": "bg-page",
  "scroll": {
    "smooth": true,
    "lockBody": true,
    "scrollX": "hidden"
  },
  "sectionOrder": [
    "nav-header",
    "hero",
    "sec-about",
    "sec-work-label",
    "sec-work",
    "sec-process-label",
    "sec-process",
    "sec-reel-label",
    "sec-reel",
    "sec-contact"
  ],
  "definitions": {
    "bg-page": {
      "preset": "bg-dark-moody"
    },
    "nav-header": {
      "preset": "preset-demo-nav-header"
    },
    "hero": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "960px",
      "selfAlign": "center",
      "align": "start",
      "height": "hug",
      "padding": {
        "base": "5rem 0 6rem",
        "md": "14rem 0 8rem"
      },
      "gap": "2rem",
      "motionTiming": {
        "staggerChildren": 0.12,
        "trigger": "onMount"
      },
      "elementOrder": ["hero-kicker", "hero-title", "hero-scroll"],
      "definitions": {
        "hero-kicker": {
          "preset": "type-kicker-badge",
          "text": "Digital Designer · Motion · Systems"
        },
        "hero-title": {
          "preset": "type-gleam-heading",
          "text": "Making complex products feel effortless.",
          "width": {
            "base": "100%",
            "md": "90%"
          },
          "motion": {
            "from": {
              "opacity": 0,
              "filter": "blur(8px)"
            },
            "to": {
              "opacity": 1,
              "filter": "blur(0px)"
            },
            "transition": {
              "duration": 0.5,
              "ease": "easeOut"
            },
            "loop": {
              "to": {
                "--pb-bg-x": [0, 100, 0]
              },
              "transition": {
                "--pb-bg-x": {
                  "duration": 6,
                  "repeat": "Infinity",
                  "ease": "easeInOut"
                }
              }
            }
          }
        },
        "hero-scroll": {
          "preset": "demo-scroll-hint"
        }
      }
    },
    "sec-about": {
      "preset": "composition-column-70-30-sidebar",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "5rem 0 6rem",
        "md": "7rem 0 10rem"
      },
      "definitions": {
        "title": {
          "text": "About the work"
        },
        "narrative": {
          "text": "I design the space between engineering constraints and user expectation — finding the interface that makes complexity feel obvious. Six years. Three continents. A hundred shipped products. The work spans design systems, interactive data products, and motion-forward consumer apps."
        },
        "meta-heading": {
          "text": "Specialisms"
        },
        "meta-list": {
          "text": "Design Systems\nInteraction Design\nMotion & Animation\nProduct Strategy\nFront-end Implementation"
        },
        "meta-link": {
          "label": "Download CV →",
          "href": "#"
        }
      }
    },
    "sec-work-label": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "padding": {
        "base": "4rem 0 2rem",
        "md": "6rem 0 3rem"
      },
      "elementOrder": ["work-heading"],
      "definitions": {
        "work-heading": {
          "preset": "type-h3-label",
          "text": "Selected work"
        }
      }
    },
    "sec-work": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "0 0 4rem",
        "md": "0 0 6rem"
      },
      "elementOrder": ["bento-grid"],
      "definitions": {
        "bento-grid": {
          "preset": "card-bento-grid"
        }
      }
    },
    "sec-process-label": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "padding": {
        "base": "4rem 0 2rem",
        "md": "6rem 0 3rem"
      },
      "elementOrder": ["proc-heading"],
      "definitions": {
        "proc-heading": {
          "preset": "type-h3-label",
          "text": "How I work"
        }
      }
    },
    "sec-process": {
      "type": "sectionColumn",
      "columns": {
        "base": 1,
        "md": 3
      },
      "columnWidths": {
        "base": [1],
        "md": [1, 1, 1]
      },
      "columnGaps": {
        "base": "1.5rem",
        "md": "2rem"
      },
      "columnAssignments": {
        "base": {
          "step-1": 0,
          "step-2": 0,
          "step-3": 0
        },
        "md": {
          "step-1": 0,
          "step-2": 1,
          "step-3": 2
        }
      },
      "contentWidth": {
        "base": "92%",
        "md": "86%"
      },
      "contentHeight": "hug",
      "gridMode": "grid",
      "gridAutoRows": "auto",
      "selfAlign": "center",
      "padding": {
        "base": "0 0 5rem",
        "md": "0 0 8rem"
      },
      "elementOrder": ["step-1", "step-2", "step-3"],
      "definitions": {
        "step-1": {
          "type": "elementGroup",
          "display": "flex",
          "flow": "column",
          "gap": "1rem",
          "width": "100%",
          "padding": "1.5rem",
          "borderRadius": "16px",
          "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
          "wrapperStyle": {
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
          },
          "section": {
            "elementOrder": ["step-num", "step-title", "step-desc"],
            "definitions": {
              "step-num": {
                "preset": "type-h2-section",
                "text": "01",
                "color": "color-mix(in oklab, var(--pb-accent) 60%, transparent)"
              },
              "step-title": {
                "preset": "type-h4-card",
                "text": "Listen hard"
              },
              "step-desc": {
                "preset": "type-body-fine",
                "text": "I spend the first phase understanding the constraint space — not just the brief, but what the team is afraid to say out loud."
              }
            }
          }
        },
        "step-2": {
          "type": "elementGroup",
          "display": "flex",
          "flow": "column",
          "gap": "1rem",
          "width": "100%",
          "padding": "1.5rem",
          "borderRadius": "16px",
          "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
          "wrapperStyle": {
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
          },
          "section": {
            "elementOrder": ["step-num", "step-title", "step-desc"],
            "definitions": {
              "step-num": {
                "preset": "type-h2-section",
                "text": "02",
                "color": "color-mix(in oklab, var(--pb-accent) 60%, transparent)"
              },
              "step-title": {
                "preset": "type-h4-card",
                "text": "Make it wrong fast"
              },
              "step-desc": {
                "preset": "type-body-fine",
                "text": "I prototype badly on purpose. The fastest path to the right answer is getting the wrong one in front of people who can tell the difference."
              }
            }
          }
        },
        "step-3": {
          "type": "elementGroup",
          "display": "flex",
          "flow": "column",
          "gap": "1rem",
          "width": "100%",
          "padding": "1.5rem",
          "borderRadius": "16px",
          "fill": "color-mix(in oklab, var(--pb-on-secondary) 6%, transparent)",
          "wrapperStyle": {
            "border": "1px solid color-mix(in oklab, var(--pb-on-secondary) 10%, transparent)"
          },
          "section": {
            "elementOrder": ["step-num", "step-title", "step-desc"],
            "definitions": {
              "step-num": {
                "preset": "type-h2-section",
                "text": "03",
                "color": "color-mix(in oklab, var(--pb-accent) 60%, transparent)"
              },
              "step-title": {
                "preset": "type-h4-card",
                "text": "Ship and learn"
              },
              "step-desc": {
                "preset": "type-body-fine",
                "text": "I hand off code-ready specs and stay through the first release. You learn more from one week of real traffic than six weeks of testing."
              }
            }
          }
        }
      }
    },
    "sec-reel-label": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "padding": {
        "base": "4rem 0 2rem",
        "md": "6rem 0 3rem"
      },
      "elementOrder": ["reel-heading"],
      "definitions": {
        "reel-heading": {
          "preset": "type-h3-label",
          "text": "Motion work"
        }
      }
    },
    "sec-reel": {
      "type": "contentBlock",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "0 0 4rem",
        "md": "0 0 6rem"
      },
      "elementOrder": ["reel-carousel"],
      "definitions": {
        "reel-carousel": {
          "preset": "card-carousel-basic",
          "section": {
            "definitions": {
              "slide-a": {
                "section": {
                  "definitions": {
                    "kicker": {
                      "text": "Brand"
                    },
                    "title": {
                      "text": "Axiom Design System"
                    },
                    "body": {
                      "text": "Motion language for 200+ components"
                    }
                  }
                }
              },
              "slide-b": {
                "section": {
                  "definitions": {
                    "kicker": {
                      "text": "Product"
                    },
                    "title": {
                      "text": "Stackform Dashboard"
                    },
                    "body": {
                      "text": "Data visualization at 60fps"
                    }
                  }
                }
              },
              "slide-c": {
                "section": {
                  "definitions": {
                    "kicker": {
                      "text": "Mobile"
                    },
                    "title": {
                      "text": "Luma Events"
                    },
                    "body": {
                      "text": "Onboarding flow animation"
                    }
                  }
                }
              },
              "slide-d": {
                "section": {
                  "definitions": {
                    "kicker": {
                      "text": "Web"
                    },
                    "title": {
                      "text": "Vercel Marketing"
                    },
                    "body": {
                      "text": "Scroll-driven hero sequence"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sec-contact": {
      "preset": "composition-flow-hero-stack",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "860px",
      "selfAlign": "center",
      "padding": {
        "base": "2.5rem 1.5rem 2.5rem",
        "md": "4rem 2rem 10rem"
      },
      "definitions": {
        "eyebrow": {
          "text": "Let's work"
        },
        "title": {
          "text": "Taking on two new projects for Q3 2026."
        },
        "lead": {
          "text": "I work with teams who care about craft and can move fast. If that's you, send a brief."
        },
        "actions": {
          "section": {
            "definitions": {
              "primary": {
                "label": "Send a brief",
                "href": "#"
              },
              "secondary": {
                "label": "See my writing",
                "href": "#"
              }
            }
          }
        }
      }
    }
  }
}
