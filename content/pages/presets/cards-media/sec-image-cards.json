{
  "preset": "demo-section",
  "elementOrder": ["sec-label", "cards-row"],
  "definitions": {
    "sec-label": {
      "preset": "type-h3-label",
      "text": "Image Feature Cards"
    },
    "cards-row": {
      "preset": "card-grid-row",
      "section": {
        "elementOrder": ["card-1", "card-2", "card-3"],
        "definitions": {
          "card-1": {
            "preset": "card-image-feature",
            "section": {
              "elementOrder": ["image", "copy"],
              "definitions": {
                "image": {
                  "type": "elementImage",
                  "src": "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&q=80&auto=format&fit=crop",
                  "alt": "Brand identity project cover",
                  "width": "100%",
                  "height": "240px",
                  "objectFit": "cover",
                  "borderRadius": "18px"
                },
                "copy": {
                  "type": "elementGroup",
                  "display": "flex",
                  "flow": "column",
                  "gap": "0.55rem",
                  "padding": "0.75rem 0.5rem 0.4rem",
                  "section": {
                    "elementOrder": ["kicker", "title", "body"],
                    "definitions": {
                      "kicker": {
                        "preset": "type-kicker-badge",
                        "text": "Brand"
                      },
                      "title": {
                        "preset": "type-h4-card",
                        "text": "NOMA — Identity"
                      },
                      "body": {
                        "preset": "type-body-fine",
                        "text": "Full brand identity for a small-batch Norwegian distillery."
                      }
                    }
                  }
                }
              }
            }
          },
