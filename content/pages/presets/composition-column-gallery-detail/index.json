{
  "contractVersion": "1.0.0",
  "title": "Composition Column Gallery Detail — Preset Demo",
  "description": "Selector gallery + detail pane structure for preview-oriented storytelling.",
  "sectionOrder": ["nav-header", "hero", "demo-primary", "demo-stress"],
  "definitions": {
    "bg-composition": {
      "type": "backgroundVariable",
      "layers": [
        {
          "fill": "radial-gradient(120% 110% at 92% 2%, color-mix(in oklab, var(--pb-accent) 16%, transparent) 0%, transparent 54%), linear-gradient(160deg, color-mix(in oklab, var(--pb-primary) 11%, var(--pb-secondary)) 0%, var(--pb-secondary) 66%, color-mix(in oklab, var(--pb-accent) 6%, var(--pb-secondary)) 100%)"
        }
      ],
      "preset": "bg-composition"
    },
    "nav-header": {
      "preset": "preset-demo-nav-header"
    },
    "hero": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "align": "start",
      "height": "hug",
      "padding": {
        "base": "10rem 0 6rem",
        "md": "12rem 0 8rem"
      },
      "gap": "1rem",
      "elementOrder": ["hero-eyebrow", "hero-title", "hero-description"],
      "definitions": {
        "hero-eyebrow": {
          "preset": "type-kicker-badge",
          "text": "Column · Gallery · Detail Pane"
        },
        "hero-title": {
          "preset": "type-h1-display",
          "text": "Composition Column Gallery Detail"
        },
        "hero-description": {
          "preset": "type-body-standard",
          "text": "Selector gallery + detail pane structure for preview-oriented storytelling.",
          "width": {
            "base": "100%",
            "md": "72%"
          }
        }
      }
    },
    "demo-primary": {
      "preset": "composition-column-gallery-detail",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "1100px",
      "selfAlign": "center",
      "padding": {
        "base": "2rem 0 4rem",
        "md": "2rem 0 5rem"
      },
      "definitions": {
        "detail": {
          "section": {
            "definitions": {
              "panel-title": {
                "text": "Atlas Operator Console"
              },
              "panel-desc": {
                "text": "Selected artifact details, notes, and action path in a dedicated pane."
              },
              "panel-cta": {
                "label": "Inspect build ->",
                "href": "#"
              }
            }
          }
        }
      }
    },
    "demo-stress": {
      "preset": "composition-column-gallery-detail",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "1100px",
      "selfAlign": "center",
      "padding": {
        "base": "0 0 8rem",
        "md": "0 0 12rem"
      },
      "definitions": {
        "gallery": {
          "section": {
            "definitions": {
              "card-a": {
                "section": {
                  "definitions": {
                    "title": {
                      "text": "Extreme Panorama"
                    },
                    "body": {
                      "text": "Very wide media crops still align to grid cadence."
                    }
                  }
                }
              },
              "card-b": {
                "section": {
                  "definitions": {
                    "title": {
                      "text": "Portrait Cut"
                    },
                    "body": {
                      "text": "Tall subject framing with concise metadata."
                    }
                  }
                }
              },
              "card-c": {
                "section": {
                  "definitions": {
                    "title": {
                      "text": "Micro Detail"
                    },
                    "body": {
                      "text": "Close crop proving fine texture handling."
                    }
                  }
                }
              }
            }
          }
        },
        "detail": {
          "section": {
            "definitions": {
              "panel-title": {
                "text": "Stress Detail Copy"
              },
              "panel-desc": {
                "text": "Longer detail copy intentionally wraps across multiple lines to verify the 8/4 split preserves hierarchy and avoids clipping even when both gallery metadata and detail annotation are verbose."
              }
            }
          }
        }
      }
    }
  },
  "presets": ["demo", "type/core", "ui/link", "type/motion", "layout", "card", "bg"],
  "bgKey": "bg-composition"
}
