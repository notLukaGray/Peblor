    "sec-press": {
      "type": "contentBlock",
      "width": "100%",
      "height": "hug",
      "padding": {
        "base": "3rem 0",
        "md": "4rem 0"
      },
      "fill": "color-mix(in oklab, var(--pb-on-secondary) 4%, transparent)",
      "elementOrder": ["press-marquee"],
      "definitions": {
        "press-marquee": {
          "preset": "type-marquee-label",
          "text": "Fast Company · Wired · The Verge · Design Week · It's Nice That · Eye On Design · Dezeen · Creative Review · Print Magazine · AIGA"
        }
      }
    },
    "sec-cta": {
      "preset": "composition-flow-hero-stack",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "860px",
      "selfAlign": "center",
      "padding": {
        "base": "2.5rem 1.5rem 2.5rem",
        "md": "4rem 2rem 8rem"
      },
      "definitions": {
        "eyebrow": {
          "text": "Join the team"
        },
        "title": {
          "text": "We’re hiring thoughtful builders."
        },
        "lead": {
          "text": "If you care about craft, move fast, and want to do the best work of your career, we want to hear from you."
        },
        "actions": {
          "section": {
            "definitions": {
              "primary": {
                "label": "See open roles",
                "href": "#"
              },
              "secondary": {
                "label": "Learn about culture",
                "href": "#"
              }
            }
          }
        }
      }
    },
    "bg-page": {
      "type": "backgroundVariable",
      "layers": [
        {
          "fill": "oklch(0.05 0.003 262)"
        },
        {
          "fill": "radial-gradient(ellipse 90% 55% at 50% -8%, oklch(0.28 0.07 265 / 0.55) 0%, transparent 68%)",
          "backgroundSize": "200% 200%",
          "motion": [
            {
              "type": "loop",
              "to": {
                "opacity": [0.65, 1, 0.65]
              },
              "transition": {
                "duration": 8,
                "ease": "easeInOut",
                "repeatType": "mirror"
              }
            }
          ]
        },
        {
          "fill": "radial-gradient(ellipse 55% 45% at 78% 72%, oklch(0.16 0.04 272 / 0.28) 0%, transparent 62%)"
        }
      ]
    },
    "sec-proof": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "padding": {
        "base": "3rem 0 4rem",
        "md": "5rem 0 7rem"
      },
      "elementOrder": ["proof-card"],
      "definitions": {
        "proof-card": {
          "preset": "card-proof-block",
          "section": {
            "definitions": {
              "quote": {
                "text": "\"Orbit doesn’t just ship work — they leave behind a team that’s smarter for having worked with them.\""
              },
              "attribution": {
                "section": {
                  "definitions": {
                    "name": {
                      "text": "Vera Huang"
                    },
                    "role": {
                      "text": "CPO, Fieldwork"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "presets": [
    "demo",
    "type/core",
    "type/effects",
    "type/motion",
    "ui/button",
    "ui/link",
    "layout",
    "card",
    "bg"
  ],
  "bgKey": "bg-page",
  "scroll": {
    "smooth": true,
    "lockBody": true,
    "scrollX": "hidden"
  }
}
