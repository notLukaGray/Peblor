{
  "contractVersion": "1.0.0",
  "title": "About — Composition Demo",
  "description": "Team and company about page: mission hero, story narrative, values grid, stats, team profiles, press marquee, proof block, and hiring CTA.",
  "sectionOrder": [
    "nav-header",
    "hero",
    "sec-story",
    "sec-values",
    "sec-stats",
    "sec-team-label",
    "sec-team",
    "sec-press",
    "sec-proof",
    "sec-cta"
  ],
  "definitions": {
    "nav-header": {
      "preset": "preset-demo-nav-header"
    },
    "hero": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "960px",
      "selfAlign": "center",
      "align": "center",
      "height": "hug",
      "padding": {
        "base": "5rem 1.5rem 8rem",
        "md": "14rem 2rem 12rem"
      },
      "gap": "2rem",
      "motionTiming": {
        "staggerChildren": 0.1,
        "trigger": "onMount"
      },
      "elementOrder": ["hero-kicker", "hero-title", "hero-body"],
      "definitions": {
        "hero-kicker": {
          "preset": "type-kicker-badge",
          "text": "Est. 2019 · Remote-first",
          "selfAlign": "center",
          "width": "auto"
        },
        "hero-title": {
          "text": "We exist to make great product design accessible to every team.",
          "selfAlign": "center",
          "textAlign": "center",
          "type": "elementHeading",
          "level": 2,
          "wordWrap": true,
          "width": {
            "base": "90%",
            "md": "62%"
          },
          "color": "var(--pb-on-secondary)",
          "motionTiming": {
            "entrancePreset": "blurIn",
            "trigger": "onFirstVisible"
          }
        },
        "hero-body": {
          "preset": "type-body-lead",
          "text": "Orbit is a distributed design-and-build studio. We partner with founders, product teams, and enterprises to close the gap between idea and shipped experience.",
          "textAlign": "center",
          "selfAlign": "center",
          "width": {
            "base": "100%",
            "md": "72%"
          }
        }
      }
    },
    "sec-story": {
      "preset": "composition-flow-asymmetric-stack",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "5rem 0 6rem",
        "md": "8rem 0 10rem"
      },
      "definitions": {
        "kicker": {
          "text": "Our story"
        },
        "headline": {
          "text": "We started as a two-person consultancy. Now we’re the studio other studios call."
        },
        "body": {
          "text": "In 2019, we shipped a design system for a seed-stage startup in six weeks. Word spread. By 2021 we had a waitlist. By 2023 we had turned down more work than we took on — not out of arrogance, but out of commitment to doing fewer things well. Today Orbit is a studio of 18 people, fully distributed, deeply embedded in the products we help build."
        },
        "quote": {
          "text": "“We measure success by whether teams can own the work after we’re gone. That’s the real delivery.” — Alex Morgan, Founder"
        },
        "actions": {
          "section": {
            "definitions": {
              "primary": {
                "label": "Work with us",
                "href": "#"
              },
              "secondary": {
                "label": "Read our story",
                "href": "#"
              }
            }
          }
        }
      }
    },
    "sec-values": {
      "preset": "composition-column-3col-features",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "4rem 0 5rem",
        "md": "6rem 0 8rem"
      },
      "definitions": {
        "feature-a": {
          "section": {
            "definitions": {
              "kicker": {
                "text": "Craft"
              },
              "title": {
                "text": "Make it real, make it right"
              },
              "body": {
                "text": "We don’t ship placeholders. Every component is production-hardened before it reaches a client."
              },
              "link": {
                "label": "Our process →",
                "href": "#"
              }
            }
          }
        },
        "feature-b": {
          "section": {
            "definitions": {
              "kicker": {
                "text": "Clarity"
              },
              "title": {
                "text": "Simple answers to hard design problems"
              },
              "body": {
                "text": "Complexity is a symptom of unclear thinking. We work until the simplest solution becomes obvious."
              },
              "link": {
                "label": "Case studies →",
                "href": "#"
              }
            }
          }
        },
        "feature-c": {
          "section": {
            "definitions": {
              "kicker": {
                "text": "Velocity"
              },
              "title": {
                "text": "Design and engineering as one motion"
              },
              "body": {
                "text": "No handoff ceremonies. Design and code evolve together from the first sketch to the final deploy."
              },
              "link": {
                "label": "How we work →",
                "href": "#"
              }
            }
          }
        }
      }
    },
    "sec-stats": {
      "preset": "composition-column-kpi-matrix",
      "width": {
        "base": "92%",
        "md": "86%"
      },
      "maxWidth": "1240px",
      "selfAlign": "center",
      "padding": {
        "base": "3rem 0 5rem",
        "md": "4rem 0 8rem"
      },
      "definitions": {
        "kpi-1": {
          "section": {
            "definitions": {
              "num": {
                "target": 6,
                "suffix": "",
                "tween": {
                  "duration": 1000
                }
              },
              "label": {
                "text": "Years building"
              },
              "body": {
                "text": "Operating since 2019 across 4 continents."
              }
            }
          }
        },
        "kpi-2": {
          "section": {
            "definitions": {
              "num": {
                "target": 140,
                "suffix": "+",
                "tween": {
                  "duration": 1200
                }
              },
              "label": {
                "text": "Projects shipped"
              },
              "body": {
                "text": "From MVPs to enterprise-scale design systems."
              }
            }
          }
        },
        "kpi-3": {
          "section": {
            "definitions": {
              "num": {
                "target": 92,
                "suffix": "%",
                "tween": {
                  "duration": 1400
                }
              },
              "label": {
                "text": "Client retention"
              },
              "body": {
                "text": "Most clients stay for the second project too."
              }
            }
          }
        },
        "kpi-4": {
          "section": {
            "definitions": {
              "num": {
                "target": 18,
                "suffix": "",
                "tween": {
                  "duration": 800
                }
              },
              "label": {
                "text": "Team members"
              },
              "body": {
                "text": "Distributed, senior, and focused."
              }
            }
          }
        }
      }
    },
    "sec-team-label": {
      "type": "contentBlock",
      "flow": "column",
      "width": {
        "base": "92%",
        "md": "72%"
      },
      "maxWidth": "900px",
      "selfAlign": "center",
      "padding": {
        "base": "5rem 0 3rem",
        "md": "8rem 0 4rem"
      },
      "elementOrder": ["team-heading", "team-desc"],
      "definitions": {
        "team-heading": {
          "preset": "type-h3-label",
          "text": "The people behind the work",
          "selfAlign": "center",
          "width": "auto"
        },
        "team-desc": {
          "preset": "type-body-standard",
          "text": "Senior practitioners from Figma, Vercel, Linear, and Stripe. No juniors, no account managers — just the people doing the work.",
          "textAlign": "center",
          "selfAlign": "center"
        }
      }
    },
    "sec-team": {
      "type": "sectionColumn",
      "columns": {
        "base": 2,
        "md": 3
      },
      "columnWidths": {
        "base": [1, 1],
        "md": [1, 1, 1]
      },
      "columnGaps": {
        "base": "1rem",
        "md": "1.5rem"
      },
      "columnAssignments": {
        "base": {
          "m-1": 0,
          "m-2": 1,
          "m-3": 0,
          "m-4": 1,
          "m-5": 0,
          "m-6": 1
        },
        "md": {
          "m-1": 0,
          "m-2": 1,
          "m-3": 2,
          "m-4": 0,
          "m-5": 1,
          "m-6": 2
        }
      },
      "contentWidth": {
        "base": "92%",
        "md": "86%"
      },
      "contentHeight": "hug",
      "gridMode": "grid",
      "gridAutoRows": "auto",
      "selfAlign": "center",
      "padding": {
        "base": "0 0 6rem",
        "md": "0 0 8rem"
      },
      "elementOrder": ["m-1", "m-2", "m-3", "m-4", "m-5", "m-6"],
      "definitions": {
