{
  "preset": "player-section",
  "elementOrder": ["player-label", "player-desc", "player-container"],
  "definitions": {
    "player-label": {
      "preset": "type-h3-label",
      "text": "Fullscreen Max"
    },
    "player-desc": {
      "preset": "type-body-fine",
      "text": "Full control set with layered HUD. Use the Fullscreen button to activate immersive mode. Controls appear in stages — basic transport always visible, seek/volume on hover, quality on explicit toggle."
    },
    "player-container": {
      "type": "elementGroup",
      "display": "flex",
      "flow": "column",
      "align": "stretch",
      "gap": "0",
      "width": "100%",
      "borderRadius": "20px",
      "scroll": "hidden",
      "wrapperStyle": {
        "position": "relative"
      },
      "section": {
        "elementOrder": ["video-surface"],
        "definitions": {
          "video-surface": {
            "type": "elementVideo",
            "module": "video-player-full",
            "src": "https://samplelib.com/preview/mp4/sample-20s.mp4",
            "poster": "",
            "width": "100%",
            "aspectRatio": "16 / 9",
            "objectFit": "cover"
          }
        }
      }
    }
  },
  "padding": {
    "base": "2rem 0",
    "md": "2rem 0 3rem"
  }
}
