{
  "type": "formBlock",
  "id": "unlock_modal_form",
  "ariaLabel": "Unlock form",
  "width": "100%",
  "height": "hug",
  "selfAlign": "center",
  "fill": "transparent",
  "contentWidth": "full",
  "action": "unlock",
  "method": "post",
  "actionPayload": {
    "redirect": "/"
  },
  "fields": [
    {
      "type": "formField",
      "fieldType": "password",
      "name": "password",
      "placeholder": "Password",
      "required": true,
      "level": 3,
      "inputStyle": {
        "borderColor": "var(--pb-accent)",
        "boxShadow": "none",
        "outline": "none"
      }
    },
    {
      "type": "formField",
      "fieldType": "button",
      "label": "Unlock",
      "loadingText": "Checking…",
      "level": 2,
      "inputClassName": "font-semibold border-0",
      "inputStyle": {
        "border": "none",
        "boxShadow": "none",
        "outline": "none"
      }
    }
  ]
}
