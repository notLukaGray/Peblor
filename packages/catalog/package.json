{
  "name": "@pb/catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "catalog:build": "tsx src/generator/index.ts",
