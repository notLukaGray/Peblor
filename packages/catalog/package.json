    "catalog:check-coverage": "tsx src/generator/check-coverage.ts",
    "catalog:sweep": "tsx src/generator/check-coverage.ts --sweep"
  },
  "dependencies": {
    "@pb/contracts": "1.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0"
  }
}
