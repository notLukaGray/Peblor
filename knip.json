{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["wait-on", "ffmpeg"],
  "ignore": [
    "apps/studio/src/**",
    "apps/web/src/core/hooks/use-device-type.ts",
    "apps/web/src/core/lib/asset-url.ts",
    "apps/web/src/core/lib/json-value.ts",
    "apps/web/src/core/ui/PageTransition.tsx",
    "packages/runtime-react/src/peblor/integrations/framer-motion/layout.ts",
    "packages/runtime-react/src/peblor/triggers/core/use-stable-value.ts",
    "scripts/migrate-responsive-tiers.ts",
    "scripts/migrate-section-column-tiers.ts",
    "scripts/sidecar-pages.mjs",
    "scripts/stamp-contract-version.ts"
  ],
  "include": ["files", "dependencies", "unlisted", "unresolved", "binaries", "catalog"],
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": ["*.{ts,tsx,js,mjs}", "scripts/**/*.{ts,tsx,js,mjs}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/web": {
      "entry": ["src/app/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["hls.js", "three"],
      "paths": {
        "@/peblor/*": ["../../packages/runtime-react/src/peblor/*"],
        "@pb/runtime-react/*": ["../../packages/runtime-react/src/*"],
        "@/core/*": ["./src/core/*"],
        "@/content/*": ["../../content/*"],
        "@/*": ["./src/*"]
      }
    },
    "apps/studio": {
      "ignoreDependencies": ["framer-motion", "tsx"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "paths": {
        "@/*": ["./src/*"]
      }
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "paths": {
        "@pb/core/internal/*": ["./src/internal/*"]
      }
    },
    "packages/extensions": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "paths": {
        "@/*": ["../../apps/web/src/*", "../contracts/src/*"]
      }
    },
    "packages/runtime-react": {
      "entry": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [],
      "ignore": ["src/peblor/background/motion/bg-layer-motion-schema.ts"],
      "paths": {
        "@pb/runtime-react/*": ["./src/*"],
        "@/peblor/*": ["./src/peblor/*"],
        "@/core/*": ["../../apps/web/src/core/*", "./src/core/*"],
        "@/content/*": ["../../content/*"],
        "@/*": ["../../apps/web/src/*", "./src/*"]
      }
    },
    "packages/sdk": {
      "project": ["src/**/*.ts"],
      "paths": {
        "@/*": ["../../apps/web/src/*", "../contracts/src/*"]
      }
    },
    "tools/figma-bridge": {
      "project": ["src/**/*.ts"]
    },
    "tools/figma-plugin": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tools/figma-widget": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tools/pb-cli": {
      "project": ["src/**/*.ts"]
    },
    "tools/dev-hls-server": {}
  }
}
