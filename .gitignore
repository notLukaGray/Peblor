/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (any workspace / package)
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# backups
*.backup
*.bak
*~

# IDE
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# Generated page manifest — built by validate-pages script
**/src/content/page-manifest.json
.vercel

# Generated JSON schemas — built by contracts:generate-schemas
packages/contracts/dist/schemas/
# Generated IDE JSON schemas (run `npm run generate-json-schemas` to rebuild)
content/schemas/

# Lighthouse CI
.lighthouseci/
.playwright-mcp/
.opencode/
.claude/
agents/
CLAUDE.md

# Generated font files — downloaded at build time by download-webfonts.ts
**/public/font/self-hosted/

# Generated page manifests — built by generate-page-manifests.ts (prebuild)
apps/web/public/manifests/

# Stolen page assets — dev-only ephemeral, never committed
apps/web/public/stolen/
test-results/
e2e/visual/
